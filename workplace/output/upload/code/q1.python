"""2026 华为杯 D 题问题一正式求解：python src/q1.python。

全部业务数据从 data/ 原始附件读取；Gate-0 只用于版本和物理口径锁定。
水平与爬升能耗的具体展开式为 DECLARED_MODEL_ASSUMPTION，并非官方公式。
"""
from __future__ import annotations

import csv
import hashlib
import json
import math
import sys
import time
from collections import Counter, defaultdict
from dataclasses import dataclass
from pathlib import Path

import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import numpy as np
from openpyxl import Workbook, load_workbook
from openpyxl.styles import Alignment, Font, PatternFill
from openpyxl.utils import get_column_letter
from pyproj import Transformer
import rasterio
from scipy.optimize import Bounds, LinearConstraint, milp
from scipy.sparse import csr_matrix, vstack


def find_project_root():
    root=Path(__file__).resolve().parents[1]
    if not (root/'data').is_dir(): raise RuntimeError(f'未找到官方 data 目录：{root}')
    return root


ROOT=find_project_root()
DATA=ROOT/'data'
OUT=ROOT/'output'/'q1'
OUT.mkdir(parents=True,exist_ok=True)
(OUT/'figures').mkdir(exist_ok=True)
LOG=[]
START=time.perf_counter()


def log(message):
    text=f'[{time.perf_counter()-START:9.3f}s] {message}'
    print(text,flush=True)
    LOG.append(text)


def dump_json(name,obj):
    (OUT/name).write_text(json.dumps(obj,ensure_ascii=False,indent=2,default=str),encoding='utf-8')


def write_csv(name,records,fields):
    with (OUT/name).open('w',encoding='utf-8-sig',newline='') as f:
        w=csv.DictWriter(f,fieldnames=fields,extrasaction='ignore')
        w.writeheader(); w.writerows(records)


def source(name):
    paths=list(DATA.rglob(name))
    if len(paths)!=1: raise RuntimeError(f'官方文件定位异常：{name}，找到 {len(paths)} 份')
    return paths[0]


def load_gate0_contract():
    gate=ROOT/'output'/'audit_gate0'
    summary=json.loads((gate/'audit_summary.json').read_text(encoding='utf-8'))
    contract=json.loads((gate/'physics_contract.json').read_text(encoding='utf-8'))
    manifest=json.loads((gate/'input_manifest.json').read_text(encoding='utf-8'))
    if summary.get('gate')!='PASS' or summary.get('q1_ready')!='YES':
        raise RuntimeError('Gate-0 未通过或 Q1_READY 不是 YES')
    expected={
      'horizontal_kwh':'E_use_g*d_ij/L_g(q)',
      'climb_kwh':'(m_empty_g+q)*9.80665*h_up_ij/(eta_up_g*3.6e6)',
      'roundtrip_kwh':'E(O01,Si,q)+E(Si,O01,0)'}
    if contract.get('status')!='DECLARED_MODEL_ASSUMPTION' or contract.get('declared_formulas')!=expected:
        raise RuntimeError('Gate-0 冻结的能耗口径与 Q1 不一致')
    if contract.get('official_rules',{}).get('range_m')!='L_g(q)=L0_g-(L0_g-LF_g)*(q/Q_g)^(3/2)':
        raise RuntimeError('Gate-0 载荷航程公式不一致')
    checked=0
    for item in manifest['files']:
        p=DATA/item['relative_path']
        if not p.is_file(): raise RuntimeError(f'Gate-0 原始文件现已缺失：{p}')
        with p.open('rb') as f: digest=hashlib.file_digest(f,'sha256').hexdigest()
        if digest!=item['sha256']: raise RuntimeError(f'Gate-0 原始文件 SHA256 已变化：{p}')
        checked+=1
    return {'gate':summary,'contract':contract,'sha256_checked_files':checked}


def section_rows(path,marker):
    """按真实表头内容找区块，不预设 Sheet 名与行号。"""
    book=load_workbook(path,read_only=True,data_only=True)
    try:
        for sheet in book:
            rows=list(sheet.iter_rows(values_only=True))
            for i,head in enumerate(rows):
                if marker in head:
                    result=[]
                    for rowno,row in enumerate(rows[i+1:],i+2):
                        if all(v is None for v in row): break
                        result.append((rowno,dict(zip(head,row))))
                    return sheet.title,result
    finally:
        book.close()
    raise RuntimeError(f'{path.name} 缺少字段 {marker}')


def positive(value,label):
    x=float(value)
    if not math.isfinite(x) or x<=0: raise RuntimeError(f'非法参数 {label}={value}')
    return x


def load_nodes():
    path=source('调度中心与服务区.xlsx')
    nodes={}
    for marker in ['调度中心编号','服务区编号']:
        sheet,rows=section_rows(path,marker)
        for rowno,row in rows:
            nid=row[marker]
            if nid in nodes: raise RuntimeError(f'节点编号重复：{nid}')
            nodes[nid]={'node_id':nid,'longitude':float(row['经度（°）']),
                'latitude':float(row['纬度（°）']),'official_elevation_m':float(row['海拔（m）']),
                'population':row.get('本次需保障人口（人）'),
                'source_sheet':sheet,'source_row':rowno}
    if set(nodes)!={'O01'}|{f'S{i:03d}' for i in range(1,16)}:
        raise RuntimeError('官方节点编号集合与 Gate-0 不一致')
    return nodes


def load_boxes():
    path=source('物资需求与配送时限.xlsx')
    sheet,rows=section_rows(path,'货箱编号')
    boxes={}
    for rowno,row in rows:
        bid=row['货箱编号']
        if bid in boxes: raise RuntimeError(f'货箱编号重复：{bid}')
        boxes[bid]={'box_id':bid,'service_id':row['服务区编号'],'category':row['物资类型'],
            'mass_kg':positive(row['单箱质量（kg）'],bid+'质量'),
            'volume_m3':positive(row['单箱体积（m³）'],bid+'体积'),
            'first_batch':row['是否首批保障'],
            'first_deadline_s':row['首批截止时间（s）'],
            'expected_delivery_s':row['期望送达时间（s）'],
            'priority_coefficient':row['应急优先系数'],
            'source_sheet':sheet,'source_row':rowno}
    if len(boxes)!=80: raise RuntimeError(f'货箱数量异常：{len(boxes)}')
    return boxes


def load_uav_parameters():
    path=source('运输无人机数据.xlsx')
    _,rows=section_rows(path,'最大载货质量（kg）')
    models={}
    required=['含电池空载总质量（kg）','最大载货质量（kg）','可用装载体积（m³）',
      '计划巡航速度（m/s）','空载标准航程（m）','满载标准航程（m）',
      '电池可用能量（kWh）','返航电量下限（%）','工位固定准备时间（s）',
      '每箱装载时间（s）','接收点基础交接时间（s）','每箱增加交接时间（s）',
      '最大爬升速度（m/s）','最大下降速度（m/s）','爬升能耗效率']
    for rowno,row in rows:
        g=row['机型编号']
        if g in models: raise RuntimeError(f'机型重复：{g}')
        for field in required:
            if row.get(field) is None: raise RuntimeError(f'{g} 缺少参数 {field}')
            if not math.isfinite(float(row[field])): raise RuntimeError(f'{g} 非有限参数 {field}')
        for field in ['含电池空载总质量（kg）','最大载货质量（kg）','可用装载体积（m³）',
          '计划巡航速度（m/s）','空载标准航程（m）','满载标准航程（m）',
          '电池可用能量（kWh）','最大爬升速度（m/s）','最大下降速度（m/s）','爬升能耗效率']:
            positive(row[field],g+field)
        if not 0<=float(row['返航电量下限（%）'])<100: raise RuntimeError(f'{g} 余量非法')
        if not 0<float(row['爬升能耗效率'])<=1: raise RuntimeError(f'{g} 爬升效率非法')
        if float(row['满载标准航程（m）'])>float(row['空载标准航程（m）']):
            raise RuntimeError(f'{g} 满载航程大于空载航程')
        models[g]={**row,'source_row':rowno}
    if set(models)!={'A','B','C'}: raise RuntimeError(f'机型集合异常：{sorted(models)}')
    return models


def load_dem():
    return rasterio.open(source('镇龙乡及周边30米DEM.tif'))


def trace_dem_cells(x0,y0,x1,y1,width,height):
    """与 Gate-0 相同的 supercover：边界、角点触及的像元全部计入。"""
    dx=x1-x0;dy=y1-y0;ts=[0.0,1.0]
    if dx:
        for k in range(math.floor(min(x0,x1)),math.ceil(max(x0,x1))+1):
            t=(k-x0)/dx
            if 0<t<1: ts.append(t)
    if dy:
        for k in range(math.floor(min(y0,y1)),math.ceil(max(y0,y1))+1):
            t=(k-y0)/dy
            if 0<t<1: ts.append(t)
    ts.sort();uniq=[]
    for t in ts:
        if not uniq or abs(t-uniq[-1])>1e-12: uniq.append(t)
    cells=set()
    def add(t):
        x=x0+dx*t;y=y0+dy*t
        xs={math.floor(x)};ys={math.floor(y)}
        if abs(x-round(x))<1e-9: xs.add(round(x)-1)
        if abs(y-round(y))<1e-9: ys.add(round(y)-1)
        for c in xs:
            for r in ys:
                if 0<=r<height and 0<=c<width: cells.add((r,c))
    for t in uniq: add(t)
    for a,b in zip(uniq,uniq[1:]): add((a+b)/2)
    return cells


def build_segments(nodes,dem,models,compare_gate=True):
    arr=dem.read(1)
    valid=(dem.read_masks(1)>0)&np.isfinite(arr)&(arr!=-32767)
    if dem.crs.to_epsg()!=4326: raise RuntimeError('DEM 坐标系与 Gate-0 不一致')
    transformer=Transformer.from_crs('EPSG:4326','EPSG:32649',always_xy=True)
    home=nodes['O01'];hx,hy=transformer.transform(home['longitude'],home['latitude'])
    segments={}
    for sid in sorted(n for n in nodes if n.startswith('S')):
        node=nodes[sid];sx,sy=transformer.transform(node['longitude'],node['latitude'])
        d=math.hypot(sx-hx,sy-hy)
        x0,y0=(~dem.transform)*(home['longitude'],home['latitude'])
        x1,y1=(~dem.transform)*(node['longitude'],node['latitude'])
        cells=trace_dem_cells(x0,y0,x1,y1,dem.width,dem.height)
        reverse=trace_dem_cells(x1,y1,x0,y0,dem.width,dem.height)
        if not cells or cells!=reverse or any(not valid[r,c] for r,c in cells):
            raise RuntimeError(f'{sid} DEM 栅格穿越失败')
        maximum=max(float(arr[r,c]) for r,c in cells)
        cruise=maximum+50
        for start,end in [('O01',sid),(sid,'O01')]:
            hstart=nodes[start]['official_elevation_m']+(30 if start!='O01' else 0)
            hend=nodes[end]['official_elevation_m']+(30 if end!='O01' else 0)
            up=cruise-hstart;down=cruise-hend
            if up<0 or down<0: raise RuntimeError(f'{start}->{end} 巡航高度低于作业高度')
            flight={g:up/float(m['最大爬升速度（m/s）'])+d/float(m['计划巡航速度（m/s）'])+
                down/float(m['最大下降速度（m/s）']) for g,m in models.items()}
            segments[(start,end)]={'start':start,'end':end,'service_id':sid,'distance_m':d,
                'cell_count':len(cells),'max_dem_m':maximum,'cruise_m':cruise,
                'start_operation_m':hstart,'end_operation_m':hend,
                'climb_m':up,'descent_m':down,'flight_time_s':flight}
    if len(segments)!=30: raise RuntimeError(f'航段数异常 {len(segments)}')
    if compare_gate:
        # Gate-0 数值只用于交叉检查，不作为本轮计算输入。
        path=ROOT/'output'/'audit_gate0'/'segment_audit.csv'
        with path.open(encoding='utf-8-sig',newline='') as f: audited=list(csv.DictReader(f))
        for old in audited:
            now=segments[(old['start'],old['end'])]
            for oldkey,newkey in [('horizontal_distance_m','distance_m'),('max_dem_elevation','max_dem_m'),
                                  ('climb_height','climb_m'),('descent_height','descent_m')]:
                if not math.isclose(float(old[oldkey]),now[newkey],rel_tol=0,abs_tol=1e-8):
                    raise RuntimeError(f'Q1 与 Gate-0 航段计算不同：{old["start"]}->{old["end"]} {oldkey}')
    return segments


def equivalent_range(model,q):
    Q=float(model['最大载货质量（kg）'])
    if not math.isfinite(q) or not 0<=q<=Q: raise ValueError(f'载荷越界 {q}/{Q}')
    L0=float(model['空载标准航程（m）']);LF=float(model['满载标准航程（m）'])
    return L0-(L0-LF)*(q/Q)**1.5


def horizontal_energy(model,d_m,q):
    # DECLARED_MODEL_ASSUMPTION，不是官方逐项能耗公式。
    return float(model['电池可用能量（kWh）'])*d_m/equivalent_range(model,q)


def climb_energy(model,h_up_m,q):
    # 含电池空载总质量已包括电池，不能重复添加。
    return (float(model['含电池空载总质量（kg）'])+q)*9.80665*h_up_m/(
        float(model['爬升能耗效率'])*3.6e6)


def segment_energy(model,segment,q):
    return horizontal_energy(model,segment['distance_m'],q)+climb_energy(model,segment['climb_m'],q)


def round_trip_energy(model,outbound,inbound,q):
    return segment_energy(model,outbound,q)+segment_energy(model,inbound,0.0)


def round_trip_time(model,outbound,inbound,box_count):
    g=model['机型编号']
    outbound_s=outbound['flight_time_s'][g];return_s=inbound['flight_time_s'][g]
    prep=float(model['工位固定准备时间（s）'])+box_count*float(model['每箱装载时间（s）'])
    delivery=float(model['接收点基础交接时间（s）'])+box_count*float(model['每箱增加交接时间（s）'])
    # 运输数据表未给单独架次周转时间；Q1 不排实体机，不凭空添加周转常数。
    return {'outbound_flight_time_s':outbound_s,'return_flight_time_s':return_s,
        'pure_flight_time_s':outbound_s+return_s,'preparation_time_s':prep,
        'delivery_time_s':delivery,'turnaround_time_s':None,
        'operation_time_s':prep+outbound_s+delivery+return_s}


def check_energy_monotonicity(model,outbound,inbound,count=101):
    Q=float(model['最大载货质量（kg）'])
    energies=[round_trip_energy(model,outbound,inbound,Q*i/(count-1)) for i in range(count)]
    return all(math.isfinite(e) and e>=0 for e in energies) and all(
        a<=b+1e-12 for a,b in zip(energies,energies[1:]))


def solve_safe_payload(sid,g,model,segments,rho):
    outbound=segments[('O01',sid)];inbound=segments[(sid,'O01')]
    Q=float(model['最大载货质量（kg）']);Euse=float(model['电池可用能量（kWh）'])
    budget=(1-rho)*Euse
    if not check_energy_monotonicity(model,outbound,inbound,101):
        if not check_energy_monotonicity(model,outbound,inbound,1001):
            raise RuntimeError(f'{sid}/{g} 能耗非单调或非有限，禁止二分')
    e0=round_trip_energy(model,outbound,inbound,0)
    eQ=round_trip_energy(model,outbound,inbound,Q)
    lower=upper=None
    if e0>budget+1e-10:
        safe=None;status='UNREACHABLE';reachable=False
    elif eQ<=budget+1e-10:
        safe=Q;status='RATED_PAYLOAD_LIMITED';reachable=True
    else:
        lower=0.0;upper=Q
        while upper-lower>0.001:
            mid=(lower+upper)/2
            if round_trip_energy(model,outbound,inbound,mid)<=budget: lower=mid
            else: upper=mid
        if round_trip_energy(model,outbound,inbound,lower)>budget+1e-10 or round_trip_energy(model,outbound,inbound,upper)<=budget:
            raise RuntimeError(f'{sid}/{g} 二分括区未验证')
        safe=lower;status='ENERGY_LIMITED';reachable=True
    esafe=round_trip_energy(model,outbound,inbound,safe) if safe is not None else None
    return {'service_id':sid,'aircraft_type':g,'rated_payload_kg':Q,'safe_payload_kg':safe,
        'limiting_factor':status,'reachable':reachable,'outbound_distance_m':outbound['distance_m'],
        'return_distance_m':inbound['distance_m'],'cruise_altitude_out_m':outbound['cruise_m'],
        'cruise_altitude_back_m':inbound['cruise_m'],'energy_empty_rt_kwh':e0,
        'energy_rated_rt_kwh':eQ,'energy_safe_payload_rt_kwh':esafe,
        'energy_budget_kwh':budget,'return_soc_at_safe_payload':1-esafe/Euse if esafe is not None else None,
        'bisection_lower_kg':lower,'bisection_upper_kg':upper,
        'bisection_energy_lower_kwh':round_trip_energy(model,outbound,inbound,lower) if lower is not None else None,
        'bisection_energy_upper_kwh':round_trip_energy(model,outbound,inbound,upper) if upper is not None else None,
        'reserve_ratio':rho,'validation_status':'PASS'}


def compute_payload_45(models,segments,rhos):
    records=[]
    for sid in [f'S{i:03d}' for i in range(1,16)]:
        for g in 'ABC': records.append(solve_safe_payload(sid,g,models[g],segments,rhos[g]))
    if len(records)!=45: raise RuntimeError('最大安全载荷结果非 45 项')
    return records


def enumerate_feasible_subsets(sid,local_boxes,models,segments,payload_by_key,rhos):
    """仅枚举本服务区。相同货箱集合保留能耗最低的机型用于词典序 MILP。"""
    n=len(local_boxes)
    if n==0: raise RuntimeError(f'{sid} 无货箱')
    out=segments[('O01',sid)];back=segments[(sid,'O01')]
    caps={g:(float(m['最大载货质量（kg）']),float(m['可用装载体积（m³）'])) for g,m in models.items()}
    max_mass=max(min(caps[g][0],payload_by_key[(sid,g)]['safe_payload_kg'] or -1) for g in models)
    max_volume=max(v for _,v in caps.values())
    candidate_records=[];raw_count=0;by_aircraft=Counter();examined=0
    if n<=20:
        # 动态规划计算每个子集的质量/体积/箱数，最多 2^20-1。
        size=1<<n;mass=[0.0]*size;volume=[0.0]*size;count=[0]*size
        masks=range(1,size)
        def metrics(mask):
            lsb=mask&-mask;i=lsb.bit_length()-1;rest=mask^lsb
            mass[mask]=mass[rest]+local_boxes[i]['mass_kg']
            volume[mask]=volume[rest]+local_boxes[i]['volume_m3']
            count[mask]=count[rest]+1
            return mass[mask],volume[mask],count[mask]
    else:
        # 大区间 DFS：只按确定性上界剪枝，绝不删掉可能可行的子集。
        collected=[]
        def dfs(i,mask,w,v,c):
            if w>max_mass+1e-9 or v>max_volume+1e-12: return
            if i==n:
                if mask: collected.append((mask,w,v,c))
                return
            dfs(i+1,mask,w,v,c)
            b=local_boxes[i]
            dfs(i+1,mask|(1<<i),w+b['mass_kg'],v+b['volume_m3'],c+1)
        dfs(0,0,0.0,0.0,0)
        masks=collected
        def metrics(item): return item[1:]
    for item in masks:
        examined+=1
        mask=item if n<=20 else item[0]
        w,v,c=metrics(item)
        if w>max_mass+1e-9 or v>max_volume+1e-12: continue
        feasible=[]
        for g,model in models.items():
            rated,capacity=caps[g]
            safe=payload_by_key[(sid,g)]['safe_payload_kg']
            if safe is None or w>rated+1e-9 or v>capacity+1e-12 or w>safe+1e-9: continue
            energy=round_trip_energy(model,out,back,w)
            budget=(1-rhos[g])*float(model['电池可用能量（kWh）'])
            if energy>budget+1e-10: continue
            times=round_trip_time(model,out,back,c)
            raw_count+=1;by_aircraft[g]+=1
            feasible.append({'candidate_id':f'{sid}-{g}-{mask:0{n}b}',
              'service_id':sid,'aircraft_type':g,'mask':mask,
              'box_ids':tuple(local_boxes[i]['box_id'] for i in range(n) if mask&(1<<i)),
              'box_count':c,'total_mass_kg':w,'total_volume_m3':v,
              'energy_kwh':energy,'return_soc':1-energy/float(model['电池可用能量（kWh）']),
              'energy_margin_kwh':budget-energy,'energy_budget_kwh':budget,
              **times})
        if feasible:
            # 同一子集仅用一架次。能耗更高的机型不可能进入严格第二优先级最优解。
            candidate_records.append(min(feasible,key=lambda x:(x['energy_kwh'],x['operation_time_s'],x['aircraft_type'])))
    covered=set()
    for c in candidate_records: covered.update(c['box_ids'])
    missing={x['box_id'] for x in local_boxes}-covered
    if missing:
        details={bid:{'mass_kg':next(b['mass_kg'] for b in local_boxes if b['box_id']==bid),
                       'volume_m3':next(b['volume_m3'] for b in local_boxes if b['box_id']==bid)} for bid in missing}
        raise RuntimeError(f'{sid} 存在无单箱可行候选：{details}; capacities={caps}; safe={[(g,payload_by_key[(sid,g)]["safe_payload_kg"]) for g in models]}')
    candidate_records.sort(key=lambda x:x['candidate_id'])
    stats={'service_id':sid,'box_count':n,'subsets_examined':examined,
           'feasible_aircraft_subset_pairs':raw_count,'candidate_count':len(candidate_records),
           'A_feasible_pairs':by_aircraft['A'],'B_feasible_pairs':by_aircraft['B'],
           'C_feasible_pairs':by_aircraft['C'],'same_subset_dominance_removed':raw_count-len(candidate_records)}
    return candidate_records,stats


def build_candidates(boxes,models,segments,payload_rows,rhos):
    payload={(r['service_id'],r['aircraft_type']):r for r in payload_rows}
    byarea=defaultdict(list)
    for b in boxes.values(): byarea[b['service_id']].append(b)
    candidates={};stats=[]
    for sid in sorted(byarea):
        local=sorted(byarea[sid],key=lambda x:x['box_id'])
        cand,stat=enumerate_feasible_subsets(sid,local,models,segments,payload,rhos)
        candidates[sid]=cand;stats.append(stat)
    return candidates,stats


def incidence_matrix(candidates,box_ids):
    index={bid:i for i,bid in enumerate(box_ids)}
    ii=[];jj=[];vv=[]
    for j,c in enumerate(candidates):
        for bid in c['box_ids']:
            ii.append(index[bid]);jj.append(j);vv.append(1.0)
    return csr_matrix((vv,(ii,jj)),shape=(len(box_ids),len(candidates)))


def _stage_record(res,elapsed):
    status='OPTIMAL' if res.status==0 and res.x is not None else f'STATUS_{res.status}'
    return {'status':status,'objective':float(res.fun) if res.fun is not None else None,
            'gap':float(getattr(res,'mip_gap',math.nan)),
            'runtime_s':elapsed,'solver_message':str(res.message)}


def solve_set_partition_highs(sid,candidates,box_ids):
    """HiGHS 三层精确 MILP：架次、能耗、累计作业时间。"""
    A=incidence_matrix(candidates,box_ids)
    n=len(candidates);ones=np.ones(n);energy=np.array([c['energy_kwh'] for c in candidates])
    operation=np.array([c['operation_time_s'] for c in candidates])
    integrality=np.ones(n,dtype=int);bounds=Bounds(np.zeros(n),np.ones(n))
    stages=[]
    def run(objective,fix_sorties=None,energy_upper=None):
        matrices=[A];lb=[np.ones(A.shape[0])];ub=[np.ones(A.shape[0])]
        if fix_sorties is not None:
            matrices.append(csr_matrix(ones.reshape(1,-1)))
            lb.append(np.array([fix_sorties],dtype=float));ub.append(np.array([fix_sorties],dtype=float))
        if energy_upper is not None:
            matrices.append(csr_matrix(energy.reshape(1,-1)))
            lb.append(np.array([-np.inf]));ub.append(np.array([energy_upper]))
        constraint=LinearConstraint(vstack(matrices,format='csr'),np.concatenate(lb),np.concatenate(ub))
        start=time.perf_counter()
        res=milp(objective,integrality=integrality,bounds=bounds,constraints=constraint,
                 options={'disp':False,'mip_rel_gap':0.0})
        elapsed=time.perf_counter()-start
        record=_stage_record(res,elapsed)
        if record['status']!='OPTIMAL': raise RuntimeError(f'{sid} HiGHS 求解失败：{record}')
        return res,record
    first,r1=run(ones);F1=int(round(first.fun));stages.append(r1)
    second,r2=run(energy,fix_sorties=F1);F2=float(second.fun);stages.append(r2)
    tol=max(1e-9,abs(F2)*1e-9)
    third,r3=run(operation,fix_sorties=F1,energy_upper=F2+tol);stages.append(r3)
    selected=[candidates[j] for j,x in enumerate(third.x) if x>0.5]
    if len(selected)!=F1 or sum(c['energy_kwh'] for c in selected)>F2+tol+1e-7:
        raise RuntimeError(f'{sid} 词典序锁定或选解异常')
    return selected,stages,tol,'HiGHS (scipy.optimize.milp)'


def solve_set_partition_gurobi(sid,candidates,box_ids):
    import gurobipy as gp
    from gurobipy import GRB
    m=gp.Model(f'Q1_{sid}');m.Params.OutputFlag=0;m.Params.MIPGap=0
    x=m.addVars(len(candidates),vtype=GRB.BINARY,name='x')
    for bid in box_ids:
        m.addConstr(gp.quicksum(x[j] for j,c in enumerate(candidates) if bid in c['box_ids'])==1)
    F1=gp.quicksum(x.values())
    F2=gp.quicksum(c['energy_kwh']*x[j] for j,c in enumerate(candidates))
    F3=gp.quicksum(c['operation_time_s']*x[j] for j,c in enumerate(candidates))
    stages=[]
    def optimize(obj):
        m.setObjective(obj,GRB.MINIMIZE);start=time.perf_counter();m.optimize()
        rec={'status':'OPTIMAL' if m.Status==GRB.OPTIMAL else f'STATUS_{m.Status}',
             'objective':m.ObjVal if m.SolCount else None,
             'gap':m.MIPGap if m.SolCount else None,'runtime_s':time.perf_counter()-start,
             'solver_message':'Gurobi'}
        if m.Status!=GRB.OPTIMAL: raise RuntimeError(f'{sid} Gurobi 求解失败：{rec}')
        stages.append(rec)
        return m.ObjVal
    f1=int(round(optimize(F1)));m.addConstr(F1==f1)
    f2=optimize(F2);tol=max(1e-9,abs(f2)*1e-9);m.addConstr(F2<=f2+tol)
    optimize(F3)
    selected=[c for j,c in enumerate(candidates) if x[j].X>0.5]
    return selected,stages,tol,'Gurobi'


def solve_lexicographic(sid,candidates,box_ids,prefer_gurobi):
    if prefer_gurobi:
        try:
            return solve_set_partition_gurobi(sid,candidates,box_ids)
        except Exception as exc:
            log(f'{sid}: Gurobi 不可用，改用 HiGHS：{exc}')
    return solve_set_partition_highs(sid,candidates,box_ids)


def solve_candidate_models(boxes,candidates,prefer_gurobi):
    box_ids=defaultdict(list)
    for b in boxes.values(): box_ids[b['service_id']].append(b['box_id'])
    chosen=[];solver_records=[]
    for sid in sorted(box_ids):
        log(f'{sid}: {len(candidates[sid])} 个 MILP 候选，开始三层求解')
        selected,stages,tol,solver=solve_lexicographic(
            sid,candidates[sid],sorted(box_ids[sid]),prefer_gurobi)
        chosen+=selected
        log(f'{sid}: 选 {len(selected)} 架次，F1/F2/F3 全部 {stages[0]["status"]}/{stages[1]["status"]}/{stages[2]["status"]}，耗时 {sum(x["runtime_s"] for x in stages):.2f}s')
        solver_records.append({'service_id':sid,'candidate_count':len(candidates[sid]),
            'selected_sorties':len(selected),'F1_status':stages[0]['status'],
            'F1_value':stages[0]['objective'],'F1_gap':stages[0]['gap'],
            'F2_status':stages[1]['status'],'F2_value':stages[1]['objective'],
            'F2_gap':stages[1]['gap'],'F3_status':stages[2]['status'],
            'F3_value':stages[2]['objective'],'F3_gap':stages[2]['gap'],
            'energy_lock_tolerance':tol,'solver':solver,
            'runtime_s':sum(x['runtime_s'] for x in stages)})
    chosen.sort(key=lambda c:(c['service_id'],c['box_ids'],c['aircraft_type']))
    return chosen,solver_records


def solve_scenario(boxes,models,segments,rhos,prefer_gurobi):
    payload=compute_payload_45(models,segments,rhos)
    candidates,stats=build_candidates(boxes,models,segments,payload,rhos)
    chosen,solver_records=solve_candidate_models(boxes,candidates,prefer_gurobi)
    return payload,chosen,stats,solver_records


def final_solution_rows(chosen,payload_rows,models):
    payload={(r['service_id'],r['aircraft_type']):r for r in payload_rows}
    records=[]
    for i,c in enumerate(chosen,1):
        g=c['aircraft_type'];sid=c['service_id'];safe=payload[(sid,g)]['safe_payload_kg']
        records.append({'sortie_id':f'Q1-{i:03d}','service_id':sid,'aircraft_type':g,
          'box_ids':','.join(c['box_ids']),'box_count':c['box_count'],
          'mass_kg':c['total_mass_kg'],'volume_m3':c['total_volume_m3'],
          'outbound_time_s':c['outbound_flight_time_s'],
          'return_time_s':c['return_flight_time_s'],
          'round_trip_flight_time_s':c['pure_flight_time_s'],
          'preparation_time_s':c['preparation_time_s'],
          'delivery_time_s':c['delivery_time_s'],
          'turnaround_time_s':c['turnaround_time_s'],
          'operation_time_s':c['operation_time_s'],
          'energy_kwh':c['energy_kwh'],'energy_budget_kwh':c['energy_budget_kwh'],
          'energy_margin_kwh':c['energy_margin_kwh'],'return_soc':c['return_soc'],
          'safe_payload_kg':safe,'payload_margin_kg':safe-c['total_mass_kg']})
    return records


def validate_sortie(row,boxes,models,segments,payload,rhos):
    """逐架次从原始对象重新汇总，不信任 MILP 候选中保存的物理数值。"""
    problems=[];sid=row['service_id'];g=row['aircraft_type']
    if sid not in {f'S{i:03d}' for i in range(1,16)}: problems.append('invalid_service');return problems,[]
    if g not in models: problems.append('invalid_aircraft_type');return problems,[]
    boxids=[x.strip() for x in row['box_ids'].split(',') if x.strip()]
    unknown=[x for x in boxids if x not in boxes]
    if unknown: problems.append('unknown_box');return problems,boxids
    if any(boxes[x]['service_id']!=sid for x in boxids): problems.append('cross_service_batch')
    model=models[g];mass=sum(boxes[x]['mass_kg'] for x in boxids)
    volume=sum(boxes[x]['volume_m3'] for x in boxids)
    if mass>float(model['最大载货质量（kg）'])+1e-9: problems.append('mass_violation')
    if volume>float(model['可用装载体积（m³）'])+1e-12: problems.append('volume_violation')
    safe=payload[(sid,g)]['safe_payload_kg']
    if safe is None or mass>safe+1e-9: problems.append('safe_payload_violation')
    e=round_trip_energy(model,segments[('O01',sid)],segments[(sid,'O01')],mass)
    budget=(1-rhos[g])*float(model['电池可用能量（kWh）'])
    soc=1-e/float(model['电池可用能量（kWh）'])
    if e>budget+1e-9 or not -1e-12<=soc<=1+1e-12 or soc<rhos[g]-1e-9:
        problems.append('energy_reserve_violation')
    times=round_trip_time(model,segments[('O01',sid)],segments[(sid,'O01')],len(boxids))
    expected={'mass_kg':mass,'volume_m3':volume,'energy_kwh':e,'energy_budget_kwh':budget,
      'energy_margin_kwh':budget-e,'return_soc':soc,'safe_payload_kg':safe,
      'payload_margin_kg':safe-mass,'outbound_time_s':times['outbound_flight_time_s'],
      'return_time_s':times['return_flight_time_s'],'round_trip_flight_time_s':times['pure_flight_time_s'],
      'preparation_time_s':times['preparation_time_s'],'delivery_time_s':times['delivery_time_s'],
      'operation_time_s':times['operation_time_s']}
    for key,value in expected.items():
        if not math.isclose(float(row[key]),value,rel_tol=1e-10,abs_tol=1e-8):
            problems.append('stored_value_mismatch:'+key)
    if row['box_count']!=len(boxids): problems.append('stored_value_mismatch:box_count')
    return problems,boxids


def validate_q1(rows,boxes,models,nodes,payload_rows,rhos):
    # 独立再读 DEM 和重算航段，避免 Validator 共用求解候选的几何缓存。
    with load_dem() as dem: fresh_segments=build_segments(nodes,dem,models,compare_gate=False)
    payload={(r['service_id'],r['aircraft_type']):r for r in payload_rows}
    observed=[];per_sortie=[]
    for row in rows:
        problems,boxids=validate_sortie(row,boxes,models,fresh_segments,payload,rhos)
        observed+=boxids
        per_sortie.append({'sortie_id':row['sortie_id'],'problems':problems})
    counts=Counter(observed)
    expected=set(boxes)
    report={'boxes_total':len(boxes),'boxes_assigned':len(observed),
      'boxes_missing':len(expected-set(counts)),
      'missing_box_ids':sorted(expected-set(counts)),
      'boxes_duplicated':sum(v-1 for v in counts.values() if v>1),
      'duplicated_box_ids':{k:v for k,v in counts.items() if v>1},
      'cross_service_batch':sum('cross_service_batch' in x['problems'] for x in per_sortie),
      'mass_violations':sum('mass_violation' in x['problems'] for x in per_sortie),
      'volume_violations':sum('volume_violation' in x['problems'] for x in per_sortie),
      'safe_payload_violations':sum('safe_payload_violation' in x['problems'] for x in per_sortie),
      'energy_reserve_violations':sum('energy_reserve_violation' in x['problems'] for x in per_sortie),
      'invalid_aircraft_type':sum('invalid_aircraft_type' in x['problems'] for x in per_sortie),
      'invalid_service':sum('invalid_service' in x['problems'] for x in per_sortie),
      'unknown_boxes':sum('unknown_box' in x['problems'] for x in per_sortie),
      'stored_value_mismatches':sum(sum(p.startswith('stored_value_mismatch') for p in x['problems']) for x in per_sortie),
      'per_sortie':per_sortie}
    numeric=[v for k,v in report.items() if k in ('boxes_missing','boxes_duplicated','cross_service_batch',
       'mass_violations','volume_violations','safe_payload_violations','energy_reserve_violations',
       'invalid_aircraft_type','invalid_service','unknown_boxes','stored_value_mismatches')]
    report['Q1_VALID']=len(rows)>0 and len(observed)==80 and all(v==0 for v in numeric)
    return report


def service_summary(rows,boxes):
    byservice=defaultdict(list)
    for row in rows: byservice[row['service_id']].append(row)
    boxcount=Counter(b['service_id'] for b in boxes.values())
    return [{'service_id':sid,'box_count':boxcount[sid],
        'selected_sorties':len(byservice[sid]),
        'aircraft_types':','.join(sorted({r['aircraft_type'] for r in byservice[sid]})),
        'total_energy_kwh':sum(r['energy_kwh'] for r in byservice[sid]),
        'total_operation_time_s':sum(r['operation_time_s'] for r in byservice[sid])}
        for sid in sorted(boxcount)]


def add_sheet(book,title,rows,fields):
    sheet=book.create_sheet(title);sheet.freeze_panes='A2';sheet.auto_filter.ref=f'A1:{get_column_letter(len(fields))}{len(rows)+1}'
    sheet.append(list(fields))
    for cell in sheet[1]:
        cell.font=Font(bold=True,color='FFFFFF')
        cell.fill=PatternFill('solid',fgColor='1F4E78')
        cell.alignment=Alignment(wrap_text=True,vertical='center')
    for row in rows:
        sheet.append([row.get(field) for field in fields])
    sheet.row_dimensions[1].height=32
    for j,field in enumerate(fields,1):
        values=[str(r.get(field,'')) for r in rows[:200]]
        width=min(55,max(13,min(42,max([len(field)]+[len(v) for v in values],default=13)+2)))
        sheet.column_dimensions[get_column_letter(j)].width=width
    for row in sheet.iter_rows(min_row=2):
        for cell in row:
            if isinstance(cell.value,float): cell.number_format='0.0000000000'
    return sheet


def export_workbook(name,sheets):
    book=Workbook();book.remove(book.active)
    for title,rows,fields in sheets: add_sheet(book,title,rows,fields)
    path=OUT/name;book.save(path)
    return path


def export_official_template(rows):
    source_path=source('结果提交模板.xlsx')
    book=load_workbook(source_path)
    if 'Q1_单点组批' not in book.sheetnames: raise RuntimeError('官方模板缺少 Q1_单点组批 Sheet')
    sheet=book['Q1_单点组批']
    expected_headers=['架次编号','服务区编号','机型编号','货箱编号列表','总质量（kg）',
      '总体积（m³）','往返时间（s）','架次能耗（kWh）','返航SOC（%）']
    if [sheet.cell(1,j).value for j in range(1,10)]!=expected_headers:
        raise RuntimeError('官方模板 Q1 表头与预期不一致')
    for i,row in enumerate(rows,2):
        values=[row['sortie_id'],row['service_id'],row['aircraft_type'],row['box_ids'],
                row['mass_kg'],row['volume_m3'],row['round_trip_flight_time_s'],
                row['energy_kwh'],row['return_soc']*100]
        for j,value in enumerate(values,1):
            cell=sheet.cell(i,j);cell.value=value
            if isinstance(value,float): cell.number_format='0.0000000000'
    sheet.freeze_panes='A2'
    for j,width in enumerate([14,14,12,65,18,18,20,20,18],1):
        sheet.column_dimensions[get_column_letter(j)].width=width
    output=OUT/'结果提交模板_Q1已填写.xlsx';book.save(output)
    return output


def verify_exported_template(path,rows):
    original=load_workbook(source('结果提交模板.xlsx'),read_only=True,data_only=True)
    produced=load_workbook(path,read_only=True,data_only=True)
    try:
        if original.sheetnames!=produced.sheetnames: raise RuntimeError('模板 Sheet 名称/顺序变化')
        for name in original.sheetnames:
            if name=='Q1_单点组批': continue
            a=list(original[name].values);b=list(produced[name].values)
            if a!=b: raise RuntimeError(f'模板非 Q1 Sheet 被更改：{name}')
        sheet=produced['Q1_单点组批'];actual=[]
        for rec in sheet.iter_rows(min_row=2,max_col=9,values_only=True):
            if rec[0] is not None: actual.append(rec)
        if len(actual)!=len(rows): raise RuntimeError(f'模板架次数不一致：{len(actual)} != {len(rows)}')
        listed=[]
        for rec,row in zip(actual,rows):
            for j,key in [(0,'sortie_id'),(1,'service_id'),(2,'aircraft_type'),(3,'box_ids')]:
                if rec[j]!=row[key]: raise RuntimeError(f'模板 {row["sortie_id"]} {key} 回读不一致')
            for j,key,scale in [(4,'mass_kg',1),(5,'volume_m3',1),(6,'round_trip_flight_time_s',1),
                                 (7,'energy_kwh',1),(8,'return_soc',100)]:
                if rec[j] is None or not math.isclose(float(rec[j]),row[key]*scale,rel_tol=1e-12,abs_tol=1e-9):
                    raise RuntimeError(f'模板 {row["sortie_id"]} {key} 数值回读不一致')
            listed.extend(rec[3].split(','))
        if len(listed)!=80 or len(set(listed))!=80: raise RuntimeError('模板箱号覆盖或唯一性异常')
        return {'official_template_export':'PASS','excel_roundtrip_check':'PASS',
                'sortie_rows':len(actual),'unique_boxes':len(set(listed)),
                'other_sheets_unchanged':True}
    finally:
        original.close();produced.close()


def scenario_totals(scenario_id,rhos,payload,chosen,solver_records):
    counts=Counter(c['aircraft_type'] for c in chosen)
    return {'scenario_id':scenario_id,'rho_A':rhos['A'],'rho_B':rhos['B'],'rho_C':rhos['C'],
      'total_sorties':len(chosen),'total_energy_kwh':sum(c['energy_kwh'] for c in chosen),
      'total_operation_time_s':sum(c['operation_time_s'] for c in chosen),
      'A_sorties':counts['A'],'B_sorties':counts['B'],'C_sorties':counts['C'],
      'minimum_return_soc':min(c['return_soc'] for c in chosen),
      'payload_reachable_cases':sum(r['reachable'] for r in payload),
      'F1_all_optimal':all(r['F1_status']=='OPTIMAL' for r in solver_records),
      'F2_all_optimal':all(r['F2_status']=='OPTIMAL' for r in solver_records),
      'F3_all_optimal':all(r['F3_status']=='OPTIMAL' for r in solver_records)}


def run_sensitivity(boxes,models,segments,base_result,prefer_gurobi):
    base_rho={g:float(m['返航电量下限（%）'])/100 for g,m in models.items()}
    all_rows=[];global_rows=[];scenario_solver={}
    seen=set()
    for delta in [-.10,-.05,0,.05,.10]:
        rhos={g:min(.999999,max(0.0,round(base_rho[g]+delta,10))) for g in 'ABC'}
        key=tuple(rhos[g] for g in 'ABC')
        if key in seen: continue
        seen.add(key)
        scenario_id=('baseline' if delta==0 else f'rho_{"minus" if delta<0 else "plus"}_{abs(round(delta*100)):02d}pp')
        if delta==0:
            payload,chosen,stats,solver=base_result
        else:
            log(f'敏感性 {scenario_id}: 开始重新计算 45 项载荷、候选和词典序 MILP')
            payload,chosen,stats,solver=solve_scenario(boxes,models,segments,rhos,prefer_gurobi)
        scenario_solver[scenario_id]=solver
        global_rows.append(scenario_totals(scenario_id,rhos,payload,chosen,solver))
        byservice_aircraft=defaultdict(list)
        for c in chosen: byservice_aircraft[(c['service_id'],c['aircraft_type'])].append(c)
        for item in payload:
            sid=item['service_id'];g=item['aircraft_type'];selected=byservice_aircraft[(sid,g)]
            all_rows.append({'scenario_id':scenario_id,'aircraft_type':g,'rho':rhos[g],
              'service_id':sid,'safe_payload_kg':item['safe_payload_kg'],
              'reachable':item['reachable'],'limiting_factor':item['limiting_factor'],
              'selected_sorties':len(selected),
              'total_energy_kwh':sum(c['energy_kwh'] for c in selected),
              'total_operation_time_s':sum(c['operation_time_s'] for c in selected),
              'minimum_return_soc':min((c['return_soc'] for c in selected),default=None)})
        log(f'敏感性 {scenario_id}: {len(chosen)} 架次，能耗 {global_rows[-1]["total_energy_kwh"]:.6f} kWh')
    if len(global_rows)<5: raise RuntimeError('返航余量合法情景不足五档')
    return all_rows,global_rows,scenario_solver


def sensitivity_narrative(detail,global_rows,baseline_payload):
    byid={x['scenario_id']:x for x in global_rows};base=byid['baseline']
    lines=['# 返航安全余量敏感性分析','',
      '各机型返航余量按官方基准值分别加减 5/10 个百分点，裁剪至 [0,1)；每档重新计算 45 项最大安全载荷、可行子集和完整三层 MILP。',
      '', '| 情景 | rho(A/B/C) | 架次 | 能耗 kWh | 累计作业 s | A/B/C 架次 | 最小返航 SOC |',
      '|---|---|---:|---:|---:|---|---:|']
    for x in global_rows:
        lines.append(f'| {x["scenario_id"]} | {x["rho_A"]:.2f}/{x["rho_B"]:.2f}/{x["rho_C"]:.2f} | {x["total_sorties"]} | {x["total_energy_kwh"]:.6f} | {x["total_operation_time_s"]:.3f} | {x["A_sorties"]}/{x["B_sorties"]}/{x["C_sorties"]} | {x["minimum_return_soc"]:.6f} |')
    baseline_map={(x['service_id'],x['aircraft_type']):x['safe_payload_kg'] for x in baseline_payload}
    high_id=max(global_rows,key=lambda x:x['rho_A'])['scenario_id']
    high_map={(x['service_id'],x['aircraft_type']):x['safe_payload_kg'] for x in detail if x['scenario_id']==high_id}
    decreased=[f'{sid}/{g}' for (sid,g),q in baseline_map.items() if q is not None and high_map[(sid,g)] is not None and high_map[(sid,g)]<q-1e-6]
    lines+=['','## 主要变化','',
      f'- 最高余量情景 {high_id} 相比基准，安全载荷下降的服务区×机型组合有 {len(decreased)} 个：{", ".join(decreased) if decreased else "无"}。',
      f'- 基准 {base["total_sorties"]} 架次；各档分别为 '+', '.join(f'{x["scenario_id"]}={x["total_sorties"]}' for x in global_rows)+'。',
      f'- 机型结构相对基准变化：'+', '.join(f'{x["scenario_id"]}={x["A_sorties"]}/{x["B_sorties"]}/{x["C_sorties"]}' for x in global_rows)+'。',
      '- 能耗与作业时间详见上表；上述数值均是情景重求解结果，并非仅重算最终 SOC。']
    (OUT/'q1_sensitivity_summary.md').write_text('\n'.join(lines)+'\n',encoding='utf-8')


def generate_figures(payload,detail,global_rows):
    labels=[f'S{i:03d}' for i in range(1,16)]
    lookup={(x['service_id'],x['aircraft_type']):x['safe_payload_kg'] for x in payload}
    fig,ax=plt.subplots(figsize=(14,5));xx=np.arange(15)
    for j,g in enumerate('ABC'):
        ax.bar(xx+(j-1)*.26,[lookup[(sid,g)] or 0 for sid in labels],width=.25,label=g)
    ax.set_xticks(xx,labels,rotation=45);ax.set_ylabel('Safe payload (kg)')
    ax.set_title('Baseline safe payload by service area');ax.legend();fig.tight_layout()
    fig.savefig(OUT/'figures'/'q1_payload_by_area.png',dpi=170);plt.close(fig)
    scenarios=[x['scenario_id'] for x in global_rows]
    fig,ax=plt.subplots(figsize=(9,5))
    for g in 'ABC':
        avg=[]
        for scenario in scenarios:
            vals=[r['safe_payload_kg'] for r in detail if r['scenario_id']==scenario and r['aircraft_type']==g and r['safe_payload_kg'] is not None]
            avg.append(sum(vals)/len(vals) if vals else math.nan)
        ax.plot(scenarios,avg,marker='o',label=g)
    ax.set_ylabel('Mean safe payload across 15 areas (kg)')
    ax.set_title('Safe payload vs. return reserve');ax.legend();ax.tick_params(axis='x',rotation=25)
    fig.tight_layout();fig.savefig(OUT/'figures'/'q1_sensitivity_payload.png',dpi=170);plt.close(fig)
    fig,ax=plt.subplots(figsize=(9,5))
    ax.plot(scenarios,[x['total_sorties'] for x in global_rows],marker='o',color='#9b3b2f')
    ax.set_ylabel('Minimum sorties');ax.set_title('Minimum sorties vs. return reserve')
    ax.tick_params(axis='x',rotation=25);ax.grid(axis='y',alpha=.3)
    fig.tight_layout();fig.savefig(OUT/'figures'/'q1_sensitivity_sorties.png',dpi=170);plt.close(fig)


def write_summary(rows,payload,service_rows,solver_rows,validation,global_rows,gateinfo,export_check):
    counts=Counter(r['aircraft_type'] for r in rows)
    solvers=sorted({x['solver'] for x in solver_rows})
    summary={'GATE0_DATA_PHYSICS':'PASS','Q1_VALID':validation['Q1_VALID'],
      'boxes_total':80,'total_mass_kg':sum(r['mass_kg'] for r in rows),
      'total_volume_m3':sum(r['volume_m3'] for r in rows),'total_sorties':len(rows),
      'total_energy_kwh':sum(r['energy_kwh'] for r in rows),
      'total_operation_time_s':sum(r['operation_time_s'] for r in rows),
      'A_sorties':counts['A'],'B_sorties':counts['B'],'C_sorties':counts['C'],
      'service_summary':service_rows,'payload_45':payload,
      'minimum_return_soc':min(r['return_soc'] for r in rows),
      'minimum_energy_margin_kwh':min(r['energy_margin_kwh'] for r in rows),
      'maximum_energy_margin_kwh':max(r['energy_margin_kwh'] for r in rows),
      'objective_1_sorties_status':'OPTIMAL' if all(x['F1_status']=='OPTIMAL' for x in solver_rows) else 'NOT_PROVEN',
      'objective_2_energy_status':'OPTIMAL' if all(x['F2_status']=='OPTIMAL' for x in solver_rows) else 'NOT_PROVEN',
      'objective_3_time_status':'OPTIMAL' if all(x['F3_status']=='OPTIMAL' for x in solver_rows) else 'NOT_PROVEN',
      'solver_used':solvers,'solver_runtime_s':sum(x['runtime_s'] for x in solver_rows),
      'total_runtime_s':time.perf_counter()-START,
      'energy_model_status':'DECLARED_MODEL_ASSUMPTION',
      'gate0_sha256_checked_files':gateinfo['sha256_checked_files'],
      'sensitivity_global':global_rows,'official_template':export_check,
      'validation':validation}
    dump_json('q1_summary.json',summary)
    lines=['# 问题一求解结果','','## 1. 数据与物理口径','',
      '官方原始数据包含 15 个服务区和 80 个不可拆货箱。每架次仅执行 O01→Si→O01；沿 DEM 像元最高值 +50m 巡航，服务区作业高度为地面 +30m；去程带货、返程空载。',
      '水平能耗和爬升能耗的具体展开式继承 Gate-0，状态为 **DECLARED_MODEL_ASSUMPTION**，并非题面逐项给出的官方公式。',
      '累计作业时间 = 工位固定准备 + 每箱装载 + 往返纯飞行 + 接收点基础交接 + 每箱增加交接。运输机参数表未列架次周转时间，Q1 不调度实体机，故未添加虚构周转常数；官方模板“往返时间”填写纯飞行往返时间。',
      '','## 2. 最大安全载荷','',
      '| 服务区 | A kg/限制 | B kg/限制 | C kg/限制 |','|---|---:|---:|---:|']
    bypayload={(x['service_id'],x['aircraft_type']):x for x in payload}
    for sid in [f'S{i:03d}' for i in range(1,16)]:
        vals=[]
        for g in 'ABC':
            p=bypayload[(sid,g)]
            vals.append(f'{p["safe_payload_kg"]:.3f} / {p["limiting_factor"]}' if p['reachable'] else 'UNREACHABLE')
        lines.append('| '+sid+' | '+' | '.join(vals)+' |')
    factors=Counter(x['limiting_factor'] for x in payload)
    lines+=['',f'共 45 项；限制因素计数：{dict(factors)}。','',
      '## 3. 最优货箱组批','',
      '| 服务区 | 箱数 | 架次 | 机型 | 总能耗 kWh | 累计作业 s |',
      '|---|---:|---:|---|---:|---:|']
    for x in service_rows:
        lines.append(f'| {x["service_id"]} | {x["box_count"]} | {x["selected_sorties"]} | {x["aircraft_types"]} | {x["total_energy_kwh"]:.6f} | {x["total_operation_time_s"]:.3f} |')
    lines+=['','## 4. 总体结果','',
      f'- 总架次数：{summary["total_sorties"]}；A/B/C：{counts["A"]}/{counts["B"]}/{counts["C"]}。',
      f'- 总运输能耗：{summary["total_energy_kwh"]:.9f} kWh。',
      f'- 累计作业时间：{summary["total_operation_time_s"]:.6f} s。',
      f'- 最小返航 SOC：{summary["minimum_return_soc"]:.9f}；能量余量范围：{summary["minimum_energy_margin_kwh"]:.9f}–{summary["maximum_energy_margin_kwh"]:.9f} kWh。',
      '','## 5. 最优性','',
      f'15 个服务区独立完整枚举可行子集（同一子集仅保留能耗词典序占优机型），然后三阶段集合划分 MILP。第一、第二、第三层状态依次为 {summary["objective_1_sorties_status"]}、{summary["objective_2_energy_status"]}、{summary["objective_3_time_status"]}；求解器：{", ".join(solvers)}。',
      '第一层架次数为整数等式锁定；第二层能耗通过每区记录的极小容差锁定，详情见求解日志。',
      '','## 6. 返航余量敏感性','',
      '详见 `q1_sensitivity_summary.md`。各档均重新求最大安全载荷、候选与词典序最优解。',
      '','## 7. Validator','',
      f'- boxes_missing={validation["boxes_missing"]}；boxes_duplicated={validation["boxes_duplicated"]}；cross_service_batch={validation["cross_service_batch"]}。',
      f'- mass_violations={validation["mass_violations"]}；volume_violations={validation["volume_violations"]}；safe_payload_violations={validation["safe_payload_violations"]}；energy_reserve_violations={validation["energy_reserve_violations"]}。',
      f'- **Q1_VALID = {str(validation["Q1_VALID"]).upper()}**；官方 Excel 导出与回读：{export_check["excel_roundtrip_check"]}。']
    (OUT/'q1_summary.md').write_text('\n'.join(lines)+'\n',encoding='utf-8')
    return summary


def main():
    print('==============================\nQ1 正式求解开始\n==============================',flush=True)
    log('[1/8] 读取 Gate-0')
    gateinfo=load_gate0_contract()
    log(f'Gate-0 PASS；原始文件 SHA256 核对 {gateinfo["sha256_checked_files"]} 份')
    log('[2/8] 加载官方数据')
    nodes=load_nodes();boxes=load_boxes();models=load_uav_parameters()
    if any(b['service_id'] not in nodes or b['service_id']=='O01' for b in boxes.values()):
        raise RuntimeError('逐箱清单含未知服务区')
    rhos={g:float(m['返航电量下限（%）'])/100 for g,m in models.items()}
    log(f'{len(nodes)} 节点、{len(boxes)} 货箱、机型 {sorted(models)}')
    log('[3/8] 构造航段')
    with load_dem() as dem: segments=build_segments(nodes,dem,models)
    log(f'{len(segments)} 条有向航段与 Gate-0 数值一致')
    log('[4/8] 计算 45 项最大安全载荷')
    payload=compute_payload_45(models,segments,rhos)
    log(f'45 项完成；限制因素：{dict(Counter(x["limiting_factor"] for x in payload))}')
    log('[5/8] 生成可行子集')
    candidates,stats=build_candidates(boxes,models,segments,payload,rhos)
    log(f'完整枚举 {sum(x["subsets_examined"] for x in stats)} 个非空同区子集；MILP 候选 {sum(x["candidate_count"] for x in stats)} 个')
    try:
        import gurobipy  # noqa: F401
        prefer_gurobi=True
        log('检测到 Gurobi，优先尝试')
    except Exception as exc:
        prefer_gurobi=False
        log(f'Gurobi 不可用（{type(exc).__name__}），使用 HiGHS')
    log('[6/8] 求解正式组批')
    chosen,solver_records=solve_candidate_models(boxes,candidates,prefer_gurobi)
    rows=final_solution_rows(chosen,payload,models)
    log(f'基准情景 {len(rows)} 架次，三层目标均完成')
    # 先完成独立物理核验；不合格时不发布正式结果。
    validation=validate_q1(rows,boxes,models,nodes,payload,rhos)
    if not validation['Q1_VALID']:
        dump_json('q1_validation_failure.json',validation)
        raise RuntimeError(f'基准情景 Validator 不通过：{validation}')
    log('[7/8] 返航余量敏感性')
    sensitivity,global_rows,scenario_solver=run_sensitivity(
        boxes,models,segments,(payload,chosen,stats,solver_records),prefer_gurobi)
    if not all(all(x['F1_status']==x['F2_status']==x['F3_status']=='OPTIMAL' for x in records)
               for records in scenario_solver.values()):
        raise RuntimeError('敏感性某情景词典序层未证明最优')
    log('[8/8] Validator 与结果导出')
    validation=validate_q1(rows,boxes,models,nodes,payload,rhos)
    if not validation['Q1_VALID']: raise RuntimeError(f'最终 Validator 不通过：{validation}')
    service_rows=service_summary(rows,boxes)
    payload_fields=list(payload[0]);batch_fields=list(rows[0]);stats_fields=list(stats[0])
    sensitivity_fields=list(sensitivity[0]);global_fields=list(global_rows[0]);solver_fields=list(solver_records[0])
    write_csv('q1_payload_45.csv',payload,payload_fields)
    export_workbook('q1_payload_45.xlsx',[('最大安全载荷',payload,payload_fields)])
    write_csv('q1_batch_solution.csv',rows,batch_fields)
    export_workbook('q1_batch_solution.xlsx',[('正式组批结果',rows,batch_fields)])
    write_csv('q1_candidate_stats.csv',stats,stats_fields)
    write_csv('q1_sensitivity.csv',sensitivity,sensitivity_fields)
    write_csv('q1_sensitivity_global.csv',global_rows,global_fields)
    export_workbook('q1_sensitivity.xlsx',[
        ('敏感性分析',sensitivity,sensitivity_fields),('全局汇总',global_rows,global_fields)])
    sensitivity_narrative(sensitivity,global_rows,payload)
    validation_summary=[{'metric':k,'value':v} for k,v in validation.items()
        if k not in ('per_sortie','missing_box_ids','duplicated_box_ids')]
    export_workbook('q1_results.xlsx',[
        ('最大安全载荷',payload,payload_fields),('正式组批结果',rows,batch_fields),
        ('服务区汇总',service_rows,list(service_rows[0])),
        ('敏感性分析',sensitivity,sensitivity_fields),
        ('求解日志',solver_records,solver_fields),
        ('Validator',validation_summary,['metric','value'])])
    official_path=export_official_template(rows)
    export_check=verify_exported_template(official_path,rows)
    validation.update(export_check)
    dump_json('q1_validation.json',validation)
    lines=['# Q1 独立 Validator','',f'Q1_VALID = {str(validation["Q1_VALID"]).upper()}','',
           '| 指标 | 数值 |','|---|---:|']
    for key,value in validation.items():
        if key not in ('per_sortie','missing_box_ids','duplicated_box_ids'):
            lines.append(f'| {key} | {value} |')
    lines+=['','原始货箱、机型、DEM 和节点重新读取；逐架次重算质量、容积、飞行时间、能耗与 SOC。',
            f'官方模板回读：{export_check["excel_roundtrip_check"]}，其他 Sheet 值保持原样。']
    (OUT/'q1_validation.md').write_text('\n'.join(lines)+'\n',encoding='utf-8')
    generate_figures(payload,sensitivity,global_rows)
    summary=write_summary(rows,payload,service_rows,solver_records,validation,global_rows,gateinfo,export_check)
    solver_log=('\n'.join(LOG)+'\n\n基准服务区三阶段 MILP：\n'+
        json.dumps(solver_records,ensure_ascii=False,indent=2)+
        '\n\n敏感性各情景三阶段 MILP：\n'+
        json.dumps(scenario_solver,ensure_ascii=False,indent=2)+'\n')
    (OUT/'q1_solver_log.txt').write_text(solver_log,encoding='utf-8')
    print('==============================\nQ1 SOLVED\n==============================')
    print('GATE0_DATA_PHYSICS = PASS')
    print('Q1_VALID = TRUE')
    for key in ['boxes_total','boxes_missing','boxes_duplicated','cross_service_batch',
      'mass_violations','volume_violations','energy_reserve_violations']:
        print(f'{key} = {validation[key]}')
    print(f'payload_cases = {len(payload)}')
    print(f'payload_cases_ready = {sum(x["reachable"] for x in payload)}')
    for key in ['total_sorties','total_energy_kwh','total_operation_time_s',
      'A_sorties','B_sorties','C_sorties']:
        print(f'{key} = {summary[key]}')
    for key in ['objective_1_sorties_status','objective_2_energy_status','objective_3_time_status']:
        print(f'{key} = {summary[key]}')
    print(f'solver = {", ".join(summary["solver_used"])}')
    print(f'runtime_s = {time.perf_counter()-START:.3f}')
    print(f'official_template_export = {export_check["official_template_export"]}')
    print(f'excel_roundtrip_check = {export_check["excel_roundtrip_check"]}')
    print(f'结果目录：{OUT}')
    print('==============================',flush=True)


if __name__=='__main__':
    try:
        main()
    except Exception as exc:
        (OUT/'q1_solver_log.txt').write_text('\n'.join(LOG)+f'\nFAILED: {type(exc).__name__}: {exc}\n',encoding='utf-8')
        raise
