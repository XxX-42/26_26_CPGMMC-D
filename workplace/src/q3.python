"""华为杯 D 题问题三：运输与单级空中中继联合调度。

运行：python src/q3.python。运输能耗展开式继承 Gate-0 的
DECLARED_MODEL_ASSUMPTION；建链悬停功耗为 DECLARED_RELAY_ENERGY_ASSUMPTION。
"""
from __future__ import annotations

import csv
import hashlib
import json
import math
import os
import shutil
import time
from collections import Counter, defaultdict
from dataclasses import dataclass
from pathlib import Path

import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import numpy as np
import rasterio
from openpyxl import Workbook, load_workbook
from openpyxl.styles import Alignment, Font, PatternFill
from openpyxl.utils import get_column_letter
from ortools.sat.python import cp_model
from pyproj import Transformer
from docx import Document

ROOT = Path(__file__).resolve().parents[1]
DATA = ROOT / 'data'
V1 = ROOT / 'output' / 'q3'
V1_FROZEN = ROOT / 'output' / 'q3_v1_frozen'
REPAIR = ROOT / 'output' / 'q3_repair'
FINAL = ROOT / 'output' / 'q3_final'
OUT = REPAIR
Q2 = ROOT / 'output' / 'q2_opt'
T0 = time.perf_counter()
LOG = []
TR = Transformer.from_crs('EPSG:4326', 'EPSG:32649', always_xy=True)
INV_TR = Transformer.from_crs('EPSG:32649', 'EPSG:4326', always_xy=True)
TIME_SCALE = 1000
ENERGY_SCALE = 1_000_000


def log(s):
    line = f'[{time.perf_counter()-T0:9.2f}s] {s}'
    print(line, flush=True)
    LOG.append(line)


def source(name):
    hits = list(DATA.rglob(name))
    if len(hits) != 1:
        raise RuntimeError(f'官方文件定位异常 {name}: {len(hits)}')
    return hits[0]


def sha(path):
    with Path(path).open('rb') as f:
        return hashlib.file_digest(f, 'sha256').hexdigest()


def jd(path):
    return json.loads(Path(path).read_text(encoding='utf-8'))


def write_json(name, obj):
    p = OUT / name
    p.write_text(json.dumps(obj, ensure_ascii=False, indent=2, default=str), encoding='utf-8')


def atomic_json(name, obj):
    p = OUT / name
    tmp = p.with_suffix(p.suffix + '.tmp')
    tmp.write_text(json.dumps(obj, ensure_ascii=False, indent=2, default=str), encoding='utf-8')
    os.replace(tmp, p)


def write_csv(name, rows, fields=None):
    fields = fields or (list(rows[0]) if rows else ['status'])
    with (OUT / name).open('w', newline='', encoding='utf-8-sig') as f:
        writer = csv.DictWriter(f, fields, extrasaction='ignore')
        writer.writeheader()
        writer.writerows(rows)


def section_rows(path, marker):
    w = load_workbook(path, read_only=True, data_only=True)
    try:
        for sheet in w:
            rows = list(sheet.iter_rows(values_only=True))
            for i, head in enumerate(rows):
                if marker in head:
                    result = []
                    for row in rows[i+1:]:
                        if all(v is None for v in row):
                            break
                        result.append(dict(zip(head, row)))
                    return result
    finally:
        w.close()
    raise RuntimeError(f'{path.name} 缺少 {marker}')


def upstream_freeze():
    gate = ROOT / 'output' / 'audit_gate0'
    summary, contract, raw = (jd(gate / x) for x in
                              ['audit_summary.json', 'physics_contract.json', 'input_manifest.json'])
    if summary.get('gate') != 'PASS' or summary.get('q1_ready') != 'YES':
        raise RuntimeError('Gate-0 未通过')
    if contract.get('status') != 'DECLARED_MODEL_ASSUMPTION':
        raise RuntimeError('冻结物理模型口径不一致')
    for f in raw['files']:
        p = DATA / f['relative_path']
        if not p.exists() or sha(p) != f['sha256']:
            raise RuntimeError(f'官方数据哈希不一致：{p}')
    q1m = jd(Q2 / 'q1_freeze_manifest.json')
    for rel, digest in q1m['files'].items():
        if sha(ROOT / rel) != digest:
            raise RuntimeError(f'Q1 冻结哈希不一致：{rel}')
    q2sum = jd(Q2 / 'q2_summary.json')
    q2val = jd(Q2 / 'q2_validation.json')
    if not q2sum.get('Q2_V2_ACCEPTED') or not q2val.get('Q2_VALID'):
        raise RuntimeError('Q2 V2 未完成或 Validator 未通过')
    if q2sum['V2']['ordinary_total_tardiness_s'] != 0 or q2sum['V2']['total_sorties'] != 25:
        raise RuntimeError('Q2 V2 基准与冻结结果不符')
    files = [ROOT/'src'/'q1.python', ROOT/'src'/'q2.python']
    files += [ROOT/x for x in q1m['files'] if x.startswith('output/q1/')]
    files += [Q2/x for x in ['best_validated_solution.json', 'q2_summary.json',
                              'q2_validation.json', 'q2_routes.csv', 'q2_box_delivery.csv',
                              '结果提交模板_Q1Q2_优化版.xlsx']]
    hashes = {str(p.relative_to(ROOT)).replace('\\','/'): sha(p) for p in files}
    state = {'files': hashes, 'gate': 'PASS', 'Q1_FREEZE_INTEGRITY': 'PASS',
             'Q2_FREEZE_INTEGRITY': 'PASS', 'q2_baseline': q2sum['V2']}
    write_json('upstream_freeze_manifest.json', state)
    return state


def read_official_q3_rules():
    """直接读取官方题面并记录 Q3 通信、资源和链路规则的段落证据。"""
    p=source('D山区洪涝灾害下无人机运输与通信协同优化.docx')
    paragraphs=[x.text.strip() for x in Document(p).paragraphs]
    terms=('问题三：通信约束','连续通信','中继无人机时间与能耗','双向链路',
           '地形遮挡','90%')
    evidence={term:[{'paragraph':i+1,'text':s} for i,s in enumerate(paragraphs)
                    if term in s][:4] for term in terms}
    missing=[term for term,rows in evidence.items() if not rows]
    if missing:raise RuntimeError(f'官方题面通信规则证据缺失：{missing}')
    write_json('q3_official_docx_rules.json',{'relative_path':str(p.relative_to(DATA)),
        'sha256':sha(p),'evidence':evidence})
    return evidence


def verify_freeze(state):
    changed = [rel for rel, digest in state['files'].items() if sha(ROOT/rel) != digest]
    if changed:
        raise RuntimeError(f'上游冻结文件发生变动：{changed}')
    return True


def load_inputs():
    nodes = {}
    p = source('调度中心与服务区.xlsx')
    for marker in ['调度中心编号', '服务区编号']:
        for row in section_rows(p, marker):
            nodes[row[marker]] = {'lon': float(row['经度（°）']),
                                  'lat': float(row['纬度（°）']),
                                  'elev': float(row['海拔（m）'])}
    boxes = {}
    for row in section_rows(source('物资需求与配送时限.xlsx'), '货箱编号'):
        bid = row['货箱编号']
        b = {'service': row['服务区编号'], 'category': row['物资类型'],
             'mass': float(row['单箱质量（kg）']), 'volume': float(row['单箱体积（m³）']),
             'expected': float(row['期望送达时间（s）']),
             'first': row['是否首批保障'] == '是',
             'first_deadline': row['首批截止时间（s）']}
        hard = []
        if b['category'] == '医疗物资': hard.append(b['expected'])
        if b['first']: hard.append(float(b['first_deadline']))
        b['hard_deadline'] = min(hard) if hard else None
        boxes[bid] = b
    p = source('运输无人机数据.xlsx')
    models = {r['机型编号']: r for r in section_rows(p, '最大载货质量（kg）')}
    uavs = defaultdict(list)
    for r in section_rows(p, '无人机编号'):
        uavs[r['机型编号']].append(r['无人机编号'])
    batteries, charge = {}, {}
    for r in section_rows(p, '共享电池组总数（组）'):
        g = r['机型编号']
        batteries[g] = [f'{g}_BAT_{k:02d}' for k in range(1,int(r['共享电池组总数（组）'])+1)]
        charge[g] = float(r['等效完全充电时间（s）'])
    p = source('中继无人机数据.xlsx')
    relay = section_rows(p, '计划起飞总质量（kg）')[0]
    relay_uavs = [r['中继无人机编号'] for r in section_rows(p, '中继无人机编号')]
    stock = section_rows(p, '共享能源组件总数（组）')[0]
    relay_components = [f'R_COMP_{k:02d}' for k in range(1,int(stock['共享能源组件总数（组）'])+1)]
    relay_charge = float(stock['等效完全充电时间（s）'])
    comm = {}
    for r in section_rows(source('通信链路参数.xlsx'), '参数名称'):
        if r.get('参数类别') is not None:
            comm[(r['参数类别'],r['参数名称'])] = float(r['参数值'])
    if len(nodes) != 16 or len(boxes) != 80 or len(relay_uavs) != 2 or len(relay_components) != 6:
        raise RuntimeError('官方节点、箱子或中继资源数量异常')
    return nodes, boxes, models, dict(uavs), batteries, charge, relay, relay_uavs, relay_components, relay_charge, comm


def trace_dem_cells(x0,y0,x1,y1,w,h):
    """Gate-0 的 supercover：边界和角点触及的像元均包含。"""
    dx,dy=x1-x0,y1-y0
    ts=[0.0,1.0]
    if dx:
        for k in range(math.floor(min(x0,x1)), math.ceil(max(x0,x1))+1):
            t=(k-x0)/dx
            if 0<t<1: ts.append(t)
    if dy:
        for k in range(math.floor(min(y0,y1)), math.ceil(max(y0,y1))+1):
            t=(k-y0)/dy
            if 0<t<1: ts.append(t)
    ts.sort()
    unique=[]
    for t in ts:
        if not unique or abs(t-unique[-1])>1e-12: unique.append(t)
    cells=set()
    def add(t):
        x,y=x0+dx*t,y0+dy*t
        xs,ys={math.floor(x)},{math.floor(y)}
        if abs(x-round(x))<1e-9: xs.add(round(x)-1)
        if abs(y-round(y))<1e-9: ys.add(round(y)-1)
        for c in xs:
            for r in ys:
                if 0<=c<w and 0<=r<h: cells.add((r,c))
    for t in unique: add(t)
    for a,b in zip(unique,unique[1:]): add((a+b)/2)
    return cells


class Terrain:
    def __init__(self):
        p=source('镇龙乡及周边30米DEM.tif')
        with rasterio.open(p) as dem:
            if dem.crs.to_epsg()!=4326: raise RuntimeError('DEM 坐标系不符')
            self.arr=dem.read(1)
            self.valid=(dem.read_masks(1)>0)&np.isfinite(self.arr)&(self.arr!=-32767)
            self.transform=dem.transform
            self.inverse=~dem.transform
            self.w,self.h=dem.width,dem.height
        self.segment_cache={}

    def cell(self,lon,lat):
        c,r=self.inverse*(lon,lat)
        r,c=math.floor(r),math.floor(c)
        if not (0<=r<self.h and 0<=c<self.w and self.valid[r,c]):
            raise ValueError(f'DEM 无效位置 {lon},{lat}')
        return r,c

    def elev(self,lon,lat):
        r,c=self.cell(lon,lat)
        return float(self.arr[r,c])

    def segment(self, a,b,ha,hb):
        key=(a[0],a[1],b[0],b[1],ha,hb)
        if key in self.segment_cache: return self.segment_cache[key]
        x0,y0=self.inverse*(a[0],a[1]);x1,y1=self.inverse*(b[0],b[1])
        cells=trace_dem_cells(x0,y0,x1,y1,self.w,self.h)
        if not cells or any(not self.valid[r,c] for r,c in cells):
            raise ValueError('航段接触 DEM 非法像元')
        high=max(float(self.arr[r,c]) for r,c in cells)+50.0
        if high<max(ha,hb)-1e-9: raise ValueError('PHYSICS_GEOMETRY_CONFLICT')
        ax,ay=TR.transform(*a[:2]);bx,by=TR.transform(*b[:2])
        d=math.hypot(bx-ax,by-ay)
        seg={'distance':d,'maxdem':high-50,'cruise':high,'up':high-ha,'down':high-hb}
        self.segment_cache[key]=seg
        return seg


def charging_time(soc, full):
    if not 0<=soc<=1: raise ValueError('SOC 越界')
    return full*(0.65*(0.9-soc)/0.9+0.35) if soc<0.9 else full*0.35*(1-soc)/0.1


def transport_leg_energy(model,seg,q):
    Q=float(model['最大载货质量（kg）'])
    L0=float(model['空载标准航程（m）']); LF=float(model['满载标准航程（m）'])
    if not 0<=q<=Q+1e-8: raise ValueError('载荷越界')
    L=L0-(L0-LF)*(q/Q)**1.5
    hor=float(model['电池可用能量（kWh）'])*seg['distance']/L
    up=(float(model['含电池空载总质量（kg）'])+q)*9.80665*seg['up']/(float(model['爬升能耗效率'])*3.6e6)
    return hor+up


def reconstruct_transport(item,nodes,boxes,models,charge,terrain):
    """从原始箱清单重算路线、时间、载荷和三维轨迹，不信任 Q2 导出的中间量。"""
    key=item['candidate_key']; g=key[0]; groups=key[1]
    model=models[g]; ids=[bid for _,bids in groups for bid in bids]
    mass=sum(boxes[b]['mass'] for b in ids)
    volume=sum(boxes[b]['volume'] for b in ids)
    if mass>float(model['最大载货质量（kg）'])+1e-9 or volume>float(model['可用装载体积（m³）'])+1e-12:
        raise ValueError('运输机载重或舱容越界')
    start=float(item['start_s']);t=start+float(model['工位固定准备时间（s）'])+len(ids)*float(model['每箱装载时间（s）'])
    phases=[]; deliveries={}; legs=[]; energy=0.;q=mass; at='O01'
    for sid,bids in list(groups)+[['O01',[]]]:
        na,nb=nodes[at],nodes[sid]
        za=na['elev']+(30 if at!='O01' else 0);zb=nb['elev']+(30 if sid!='O01' else 0)
        seg=terrain.segment((na['lon'],na['lat']),(nb['lon'],nb['lat']),za,zb)
        climb=seg['up']/float(model['最大爬升速度（m/s）'])
        cruise=seg['distance']/float(model['计划巡航速度（m/s）'])
        descent=seg['down']/float(model['最大下降速度（m/s）'])
        p0=(na['lon'],na['lat'],za);p1=(na['lon'],na['lat'],seg['cruise'])
        phases.append({'kind':'climb','from':at,'to':sid,'start':t,'end':t+climb,'p0':p0,'p1':p1})
        t+=climb;p0=p1;p1=(nb['lon'],nb['lat'],seg['cruise'])
        phases.append({'kind':'cruise','from':at,'to':sid,'start':t,'end':t+cruise,'p0':p0,'p1':p1})
        t+=cruise;p0=p1;p1=(nb['lon'],nb['lat'],zb)
        phases.append({'kind':'descent','from':at,'to':sid,'start':t,'end':t+descent,'p0':p0,'p1':p1})
        t+=descent
        e=transport_leg_energy(model,seg,q);energy+=e
        legs.append({'from':at,'to':sid,'load_kg':q,'energy_kwh':e,**seg})
        if sid!='O01':
            service=float(model['接收点基础交接时间（s）'])+len(bids)*float(model['每箱增加交接时间（s）'])
            phases.append({'kind':'service','from':sid,'to':sid,'start':t,'end':t+service,'p0':p1,'p1':p1})
            t+=service
            for bid in bids: deliveries[bid]=t
            q-=sum(boxes[bid]['mass'] for bid in bids)
        at=sid
    Euse=float(model['电池可用能量（kWh）']);soc=1-energy/Euse
    if soc+1e-10<float(model['返航电量下限（%）'])/100: raise ValueError('运输返航余量不足')
    return {'sortie_id':item.get('sortie_id'),'g':g,'uav_id':item['uav_id'],'battery_id':item['battery_id'],
            'start_s':start,'takeoff_s':phases[0]['start'],'return_s':t,'full_s':t+charging_time(soc,charge[g]),
            'groups':groups,'box_ids':ids,'mass_kg':mass,'volume_m3':volume,'energy_kwh':energy,'return_soc':soc,
            'deliveries':deliveries,'legs':legs,'phases':phases}


def load_q2_transport(nodes,boxes,models,charge,terrain):
    data=jd(Q2/'best_validated_solution.json')
    items=[]
    for raw in data['selected']:
        row={'candidate_key':raw['candidate_key'],'start_s':raw['start_s'],
             'uav_id':raw['uav_id'],'battery_id':raw['battery_id']}
        items.append(row)
    items.sort(key=lambda x:(x['start_s'],x['uav_id']))
    for i,item in enumerate(items,1): item['sortie_id']=f'Q3-T{i:03d}'
    routes=[reconstruct_transport(i,nodes,boxes,models,charge,terrain) for i in items]
    for route in routes:
        if route['sortie_id'] is None: raise RuntimeError('Q2 ID 异常')
    if abs(sum(r['energy_kwh'] for r in routes)-data['metrics']['total_energy_kwh'])>1e-7:
        raise RuntimeError('Q2 能耗独立重算与冻结结果不一致')
    return items,routes


def comm_parameters(raw):
    def get(cat,prefix):
        hits=[v for (c,n),v in raw.items() if c==cat and n.startswith(prefix)]
        if len(hits)!=1: raise RuntimeError(f'通信参数缺失：{cat}/{prefix}')
        return hits[0]
    common={'freq':get('传播参数','载波频率'),'sys_loss':get('传播参数','系统损耗'),
            'obs_loss':get('传播参数','地形遮挡'),
            'sens':get('接收参数','接收灵敏度'),'fade':get('接收参数','衰落裕量')}
    endpoints={}
    for code,cat in [('T','运输无人机'),('RA','中继接入端'),('RB','中继回传端'),('G','固定网关 G01')]:
        endpoints[code]={'ptx':get(cat,'发射功率'),'gain':get(cat,'天线增益')}
    common['gateway_height']=get('固定网关 G01','天线离地高度')
    common['endpoints']=endpoints
    return common


def link_budget(comm,a,b):
    ep=comm['endpoints'];p=comm['sens']+comm['fade'];loss=comm['sys_loss']
    ab=ep[a]['ptx']+ep[a]['gain']+ep[b]['gain']-loss-p
    ba=ep[b]['ptx']+ep[b]['gain']+ep[a]['gain']-loss-p
    return min(ab,ba)


def link_radii(comm,a,b):
    L=link_budget(comm,a,b)
    clear=10**((L-32.45-20*math.log10(comm['freq']))/20)*1000
    return clear, clear*10**(-comm['obs_loss']/20)


def clip_ray_cell(x0,y0,x1,y1,c,r):
    """射线与闭像元矩形相交的精确参数范围。"""
    lo,hi=0.,1.
    for p,d,mn,mx in [(x0,x1-x0,c,c+1),(y0,y1-y0,r,r+1)]:
        if abs(d)<1e-15:
            if p<mn-1e-12 or p>mx+1e-12: return None
        else:
            a,b=(mn-p)/d,(mx-p)/d
            if a>b:a,b=b,a
            lo=max(lo,a);hi=min(hi,b)
            if lo>hi+1e-12:return None
    return lo,hi


def terrain_blocked(terrain,a,b):
    x0,y0=terrain.inverse*(a[0],a[1]);x1,y1=terrain.inverse*(b[0],b[1])
    cells=trace_dem_cells(x0,y0,x1,y1,terrain.w,terrain.h)
    if any(not terrain.valid[r,c] for r,c in cells): raise ValueError('LOS 接触 DEM 非法像元')
    for r,c in cells:
        clip=clip_ray_cell(x0,y0,x1,y1,c,r)
        if clip is None: continue
        zlo=min(a[2]+(b[2]-a[2])*clip[0],a[2]+(b[2]-a[2])*clip[1])
        if float(terrain.arr[r,c])>=zlo-1e-9: return True
    return False


def evaluate_link(terrain,comm,code_a,a,code_b,b):
    ax,ay=TR.transform(a[0],a[1]);bx,by=TR.transform(b[0],b[1])
    d=math.sqrt((ax-bx)**2+(ay-by)**2+(a[2]-b[2])**2)
    if d<=0: raise ValueError('通信端点重合')
    clear,blocked=link_radii(comm,code_a,code_b)
    obs=(d>blocked and d<=clear and terrain_blocked(terrain,a,b)) or d>clear
    fspl=32.45+20*math.log10(comm['freq'])+20*math.log10(d/1000)
    total=fspl+(comm['obs_loss'] if obs else 0)
    margin=link_budget(comm,code_a,code_b)-total
    return {'distance_3d_m':d,'fspl_db':fspl,'terrain_blocked':bool(obs),
            'obstruction_loss_db':comm['obs_loss'] if obs else 0,
            'total_loss_db':total,'allowed_loss_db':link_budget(comm,code_a,code_b),
            'margin_db':margin,'available':margin>=-1e-10}


def phase_position(phase,t):
    d=phase['end']-phase['start']
    u=0 if d<=0 else max(0,min(1,(t-phase['start'])/d))
    return tuple(phase['p0'][k]*(1-u)+phase['p1'][k]*u for k in range(3))


def gateway(nodes,comm):
    n=nodes['O01']
    return n['lon'],n['lat'],n['elev']+comm['gateway_height']


def distance_upper_on_phase(phase,a,b,station):
    """固定点至线性运动点的距离是凸函数，最大值在区间端点。"""
    def dist(p):
        x,y=TR.transform(p[0],p[1]);sx,sy=TR.transform(station[0],station[1])
        return math.sqrt((x-sx)**2+(y-sy)**2+(p[2]-station[2])**2)
    return max(dist(phase_position(phase,a)),dist(phase_position(phase,b)))


def swept_clear(terrain,phase,a,b,station):
    """固定站点—线性飞行端点扫掠视线的像元级保守认证。

    对每个被扫掠像元，线段进入/离开像元的参数只会在穿过像元角点、
    飞行端点跨越像元边界或坐标分母过零时更换表达式。各区间内视线
    高度为线性或分式线性函数，极小值在区间端点；保留中点处理退化。
    """
    pa,pb=phase_position(phase,a),phase_position(phase,b)
    sx,sy=terrain.inverse*(station[0],station[1])
    ax,ay=terrain.inverse*(pa[0],pa[1]);bx,by=terrain.inverse*(pb[0],pb[1])
    # 对每个栅格行求扫掠三角形的 x 跨度，避免遍历大矩形。
    r0=max(0,math.floor(min(sy,ay,by))-1);r1=min(terrain.h-1,math.ceil(max(sy,ay,by))+1)
    dx,dy=bx-ax,by-ay
    if min(math.hypot(ax-sx,ay-sy),math.hypot(bx-sx,by-sy))<1e-10:
        return False
    edges=[((sx,sy),(ax,ay)),((ax,ay),(bx,by)),((bx,by),(sx,sy))]
    for r in range(r0,r1+1):
        xx=[]
        for (x0,y0),(x1,y1) in edges:
            for y in (r,r+1):
                if min(y0,y1)-1e-9<=y<=max(y0,y1)+1e-9:
                    xx.append(x0 if abs(y1-y0)<1e-12 else x0+(x1-x0)*(y-y0)/(y1-y0))
            if r-1e-9<=y0<=r+1+1e-9:xx.append(x0)
            if r-1e-9<=y1<=r+1+1e-9:xx.append(x1)
        if not xx:continue
        c0=max(0,math.floor(min(xx))-1);c1=min(terrain.w-1,math.ceil(max(xx))+1)
        for c in range(c0,c1+1):
            if not terrain.valid[r,c]: return False
            critical=[0.,1.]
            def root(p,q):
                if abs(q)>1e-14:
                    v=-p/q
                    if 0<v<1:critical.append(v)
            for edge in (c,c+1):root(ax-edge,dx)
            for edge in (r,r+1):root(ay-edge,dy)
            root(ax-sx,dx);root(ay-sy,dy)
            for cx in (c,c+1):
                for cy in (r,r+1):
                    root((cx-sx)*(ay-sy)-(cy-sy)*(ax-sx),
                         (cx-sx)*dy-(cy-sy)*dx)
            critical=sorted(set(critical))
            probes=critical+[(u+v)/2 for u,v in zip(critical,critical[1:])]
            found=False;zlo=math.inf
            for v in probes:
                px,py=ax+dx*v,ay+dy*v
                clip=clip_ray_cell(sx,sy,px,py,c,r)
                if clip is None:continue
                found=True
                pz=pa[2]+(pb[2]-pa[2])*v
                zlo=min(zlo,station[2]+(pz-station[2])*clip[0],
                        station[2]+(pz-station[2])*clip[1])
            if found and float(terrain.arr[r,c])>=zlo-1e-7:return False
    return True


def certify_station_interval(terrain,comm,phase,a,b,station,code,depth=0):
    """返回保守链路认证区间；未知不会被当作可用。"""
    clear,blocked=link_radii(comm,'T',code)
    dmax=distance_upper_on_phase(phase,a,b,station)
    lim=link_budget(comm,'T',code)
    if dmax<=blocked:
        margin=lim-(32.45+20*math.log10(comm['freq'])+20*math.log10(max(dmax,1e-6)/1000)+comm['obs_loss'])
        return [(a,b,'CERTIFIED_AVAILABLE',margin)]
    if dmax<=clear and swept_clear(terrain,phase,a,b,station):
        margin=lim-(32.45+20*math.log10(comm['freq'])+20*math.log10(max(dmax,1e-6)/1000))
        return [(a,b,'CERTIFIED_AVAILABLE',margin)]
    # 对明确失联点记录证据；其他区间在细分下限仍未证明时保持未知。
    if b-a<=0.02 or depth>=19:
        mid=(a+b)/2
        status='CERTIFIED_UNAVAILABLE' if not evaluate_link(terrain,comm,'T',phase_position(phase,mid),code,station)['available'] else 'UNCERTIFIED'
        return [(a,b,status,float('-inf'))]
    m=(a+b)/2
    return (certify_station_interval(terrain,comm,phase,a,m,station,code,depth+1)+
            certify_station_interval(terrain,comm,phase,m,b,station,code,depth+1))


def sample_direct(routes,terrain,comm,gw,step_m=35.0):
    """用于候选生成的直连诊断；正式结论由独立区间认证给出。"""
    phases=[]; demands=[]; did=0
    for route in routes:
        for pi,p in enumerate(route['phases']):
            x0,y0=TR.transform(*p['p0'][:2]);x1,y1=TR.transform(*p['p1'][:2])
            travel=math.sqrt((x1-x0)**2+(y1-y0)**2+(p['p1'][2]-p['p0'][2])**2)
            n=max(1,math.ceil(travel/step_m),math.ceil((p['end']-p['start'])/30))
            ts=[p['start']+(p['end']-p['start'])*j/n for j in range(n+1)]
            vals=[evaluate_link(terrain,comm,'T',phase_position(p,t),'G',gw) for t in ts]
            phases.append({'sortie_id':route['sortie_id'],'phase_index':pi,'phase':p['kind'],
                           'start_s':p['start'],'end_s':p['end'],
                           'direct_coverage_fraction':sum(v['available'] for v in vals)/len(vals),
                           'minimum_direct_margin_db':min(v['margin_db'] for v in vals)})
            # 在可用状态变换的采样格内二分边界，避免把直连可用时间误作中继需求。
            false_spans=[]
            for j in range(n):
                left,right=vals[j]['available'],vals[j+1]['available']
                if left==right:
                    if not left:false_spans.append((ts[j],ts[j+1]))
                    continue
                lo,hi=ts[j],ts[j+1]
                for _ in range(17):
                    mid=(lo+hi)/2
                    value=evaluate_link(terrain,comm,'T',phase_position(p,mid),'G',gw)['available']
                    if value==left:lo=mid
                    else:hi=mid
                cut=(lo+hi)/2
                false_spans.append((cut,ts[j+1]) if left else (ts[j],cut))
            runs=[]
            for a,b in false_spans:
                if runs and a<=runs[-1][1]+1e-6:runs[-1]=(runs[-1][0],max(b,runs[-1][1]))
                else:runs.append((a,b))
            for a,b in runs:
                if b-a<1e-6:continue
                did+=1
                demands.append({'demand_id':f'D{did:04d}','sortie_id':route['sortie_id'],
                                'phase_index':pi,'phase':p['kind'],'start_s':a,'end_s':b,
                                'duration_s':b-a,'start_position':phase_position(p,a),
                                'mid_position':phase_position(p,(a+b)/2),
                                'end_position':phase_position(p,b),
                                'minimum_direct_margin_db':min([vv['margin_db'] for tt,vv in zip(ts,vals)
                                                               if a-1e-8<=tt<=b+1e-8] or
                                                              [evaluate_link(terrain,comm,'T',phase_position(p,(a+b)/2),'G',gw)['margin_db']]),
                                'reason':'sampled direct link unavailable'})
    return phases,demands


def partition_demands(blind,routes,max_distance_m=400,max_duration_s=120):
    phase_map={(r['sortie_id'],i):p for r in routes for i,p in enumerate(r['phases'])}
    pieces=[]
    for original in blind:
        p=phase_map[original['sortie_id'],original['phase_index']]
        a,b=original['start_s'],original['end_s']
        pa,pb=phase_position(p,a),phase_position(p,b)
        x0,y0=TR.transform(*pa[:2]);x1,y1=TR.transform(*pb[:2])
        d=math.sqrt((x1-x0)**2+(y1-y0)**2+(pa[2]-pb[2])**2)
        n=max(1,math.ceil(d/max_distance_m),math.ceil((b-a)/max_duration_s))
        for j in range(n):
            s=a+(b-a)*j/n;e=a+(b-a)*(j+1)/n
            row=dict(original);row['parent_demand_id']=original['demand_id']
            row['demand_id']=f"{original['demand_id']}-P{j+1:02d}"
            row['start_s']=s;row['end_s']=e;row['duration_s']=e-s
            row['start_position']=phase_position(p,s)
            row['mid_position']=phase_position(p,(s+e)/2)
            row['end_position']=phase_position(p,e)
            pieces.append(row)
    return pieces


def relay_flight(terrain,nodes,relay,lon,lat,agl):
    if agl<=0 or agl>float(relay['最大悬停离地高度（m）'])+1e-9:return None
    ground=terrain.elev(lon,lat);z=ground+agl
    o=nodes['O01'];base=(o['lon'],o['lat']);point=(lon,lat)
    try:
        # 净空巡航海拔仍为沿线最高 DEM +50m。悬停点更高时在目的地
        # 额外垂直爬升，返程先下降至巡航海拔；这是显式补充假设。
        out=terrain.segment(base,point,o['elev'],o['elev'])
        back=terrain.segment(point,base,o['elev'],o['elev'])
    except ValueError:return None
    v=float(relay['计划巡航速度（m/s）']);vu=float(relay['最大爬升速度（m/s）']);vd=float(relay['最大下降速度（m/s）'])
    out_terminal_up=max(0,z-out['cruise'])
    out_terminal_down=max(0,out['cruise']-z)
    back_start_up=max(0,back['cruise']-z)
    back_start_down=max(0,z-back['cruise'])
    out_time=out['up']/vu+out['distance']/v+out_terminal_up/vu+out_terminal_down/vd
    back_time=back_start_up/vu+back_start_down/vd+back['distance']/v+back['down']/vd
    flight=out_time+back_time
    cruise=float(relay['巡航功率（kW）'])*(out['distance']+back['distance'])/v/3600
    climb_height=out['up']+out_terminal_up+back_start_up
    climb=float(relay['计划起飞总质量（kg）'])*9.80665*climb_height/(float(relay['爬升能耗效率'])*3.6e6)
    return {'lon':lon,'lat':lat,'ground_m':ground,'agl_m':agl,'alt_m':z,
            'out_s':out_time,'back_s':back_time,'flight_s':flight,
            'flight_energy_kwh':cruise+climb,'out_seg':out,'back_seg':back,
            'terminal_vertical_transition':out_terminal_up>0 or back_start_down>0}


def relay_energy(relay,flight,service_s):
    # 建链期间持续悬停并开通信模块，是明确记录的补充建模假设。
    hover=float(relay['悬停功率（kW）']);comm=float(relay['通信附加功率（kW）'])
    link=float(relay['建链时间（s）'])
    return flight['flight_energy_kwh']+(hover+comm)*(link+service_s)/3600


def candidate_locations(demands,nodes,terrain,relay):
    """盲区走廊周围的粗点，去重后配离地高度层。"""
    xy={}
    def add(lon,lat,reason):
        try: terrain.cell(lon,lat)
        except ValueError:return
        x,y=TR.transform(lon,lat);key=(round(x/100),round(y/100))
        xy.setdefault(key,(lon,lat,reason))
    center=nodes['O01'];ox,oy=TR.transform(center['lon'],center['lat'])
    for d in demands:
        for pos in [d['start_position'],d['mid_position'],d['end_position']]:
            px,py=TR.transform(pos[0],pos[1])
            for f in (0.45,0.7,0.9,1.0):
                cx,cy=ox+f*(px-ox),oy+f*(py-oy)
                for dx,dy in [(0,0),(500,0),(-500,0),(0,500),(0,-500)]:
                    lon,lat=INV_TR.transform(cx+dx,cy+dy);add(lon,lat,'blind_corridor')
    for sid,n in nodes.items():
        if sid=='O01':continue
        if not any(d['sortie_id'] for d in demands if math.hypot(TR.transform(n['lon'],n['lat'])[0]-TR.transform(d['mid_position'][0],d['mid_position'][1])[0],TR.transform(n['lon'],n['lat'])[1]-TR.transform(d['mid_position'][0],d['mid_position'][1])[1])<1500):
            continue
        sx,sy=TR.transform(n['lon'],n['lat'])
        for dx,dy in [(0,0),(500,0),(-500,0),(0,500),(0,-500)]:
            add(*INV_TR.transform(sx+dx,sy+dy),'service_nearby')
    # 固定排序确保重复运行稳定；过密时按到盲区的最小距离选取，而非随机抽点。
    places=list(xy.values())
    if len(places)>100:
        mids=[TR.transform(d['mid_position'][0],d['mid_position'][1]) for d in demands]
        projected=[TR.transform(p[0],p[1]) for p in places]
        ordered=[]
        for x,y in mids:
            for idx in sorted(range(len(places)),key=lambda j:math.hypot(projected[j][0]-x,projected[j][1]-y))[:2]:
                if idx not in ordered:ordered.append(idx)
        rest=sorted(range(len(places)),key=lambda j:min(math.hypot(projected[j][0]-x,projected[j][1]-y) for x,y in mids))
        for idx in rest:
            if len(ordered)>=100:break
            if idx not in ordered:ordered.append(idx)
        places=[places[j] for j in ordered[:100]]
    out=[]
    max_agl=float(relay['最大悬停离地高度（m）'])
    levels=sorted({min(max_agl,h) for h in [50,100,200,300,max_agl] if h<=max_agl})
    for lon,lat,reason in places:
        for h in levels:
            try: f=relay_flight(terrain,nodes,relay,lon,lat,h)
            except ValueError:continue
            if f is not None:
                f['reason']=reason;out.append(f)
    return out


def coverage_matrix(candidates,demands,routes,terrain,comm,gw,relay):
    phase_map={(r['sortie_id'],i):p for r in routes for i,p in enumerate(r['phases'])}
    Euse=float(relay['能源组件可用能量（kWh）']);rho=float(relay['返航电量下限（%）'])/100
    keep=[];links=defaultdict(list)
    for j,c in enumerate(candidates):
        pos=(c['lon'],c['lat'],c['alt_m'])
        back=evaluate_link(terrain,comm,'RB',pos,'G',gw)
        if not back['available'] or c['flight_energy_kwh']>=Euse*(1-rho):continue
        covered=[]
        for d in demands:
            mid=d['mid_position']
            if not evaluate_link(terrain,comm,'T',mid,'RA',pos)['available']:continue
            p=phase_map[d['sortie_id'],d['phase_index']]
            # 求解预筛采用多点采样；正式解须另经独立保守区间认证。
            probes=np.linspace(d['start_s'],d['end_s'],7)
            if all(evaluate_link(terrain,comm,'T',phase_position(p,t),'RA',pos)['available']
                   for t in probes):
                covered.append(d['demand_id'])
        if covered:
            c=dict(c);c['id']=f'RC{len(keep)+1:04d}';c['backhaul_margin_db']=back['margin_db']
            c['covered_demands']=covered
            keep.append(c)
            for did in covered:links[did].append(c['id'])
    return keep,links


def fill_uncovered(candidates,links,demands,nodes,terrain,comm,gw,relay,routes):
    missing=[d for d in demands if d['demand_id'] not in links]
    if not missing:return candidates,links,[]
    additions=[]
    ox,oy=TR.transform(*gw[:2])
    seen={(round(c['lon'],5),round(c['lat'],5),c['agl_m']) for c in candidates}
    for d in missing:
        px,py=TR.transform(*d['mid_position'][:2]);hits=[]
        for f in [0.25,0.4,0.55,0.7,0.85,1.0]:
            cx,cy=ox+f*(px-ox),oy+f*(py-oy)
            for dx in range(-1500,1501,250):
                for dy in range(-1500,1501,250):
                    lon,lat=INV_TR.transform(cx+dx,cy+dy)
                    try:ground=terrain.elev(lon,lat)
                    except ValueError:continue
                    for agl in (50,100,150,200,250,300):
                        if agl>float(relay['最大悬停离地高度（m）']):continue
                        key=(round(lon,5),round(lat,5),agl)
                        if key in seen:continue
                        pos=(lon,lat,ground+agl)
                        if not evaluate_link(terrain,comm,'T',d['mid_position'],'RA',pos)['available']:continue
                        if not evaluate_link(terrain,comm,'RB',pos,'G',gw)['available']:continue
                        flight=relay_flight(terrain,nodes,relay,lon,lat,agl)
                        if flight is None:continue
                        hits.append((flight['flight_energy_kwh']+0.0001*math.hypot(dx,dy),flight,key))
            if len(hits)>=10:break
        for _,flight,key in sorted(hits,key=lambda x:x[0])[:12]:
            if key not in seen:
                seen.add(key);flight['reason']='targeted_uncovered';additions.append(flight)
    if additions:
        more,morelinks=coverage_matrix(additions,demands,routes,terrain,comm,gw,relay)
        for c in more:
            c['id']=f'RC{len(candidates)+1:04d}'
            candidates.append(c)
            for did in c['covered_demands']:links[did].append(c['id'])
    return candidates,links,missing


def select_relay_candidates(candidates,demands,limit=100):
    """保留每个盲区的备选，同时用贪心覆盖压缩 CP-SAT 选项数。"""
    universe={d['demand_id'] for d in demands}
    picked=[];uncovered=set(universe)
    pool=sorted(candidates,key=lambda c:(-len(c['covered_demands']),c['flight_energy_kwh']))
    while uncovered and len(picked)<limit:
        best=max((c for c in pool if c not in picked),
                 key=lambda c:(len(uncovered.intersection(c['covered_demands'])),
                               len(c['covered_demands']),-c['flight_energy_kwh']))
        gain=uncovered.intersection(best['covered_demands'])
        if not gain:break
        picked.append(best);uncovered-=gain
    # 每项需求至少保留三处不同悬停点供资源调度和 margin 修复选择。
    for did in sorted(universe):
        options=[c for c in pool if did in c['covered_demands']]
        for c in options[:3]:
            if c not in picked:picked.append(c)
    for c in pool:
        if len(picked)>=limit:break
        if c not in picked:picked.append(c)
    return picked[:limit],sorted(uncovered)


def build_relay_options(candidates,demands,relay,relay_charge,max_options=8000):
    """固定可追溯服务窗选项；每项包含完整悬停和充电占用。"""
    byid={d['demand_id']:d for d in demands}
    Euse=float(relay['能源组件可用能量（kWh）'])
    budget=Euse*(1-float(relay['返航电量下限（%）'])/100)
    prep=float(relay['工位固定准备时间（s）']);link=float(relay['建链时间（s）'])
    turn=float(relay['架次周转时间（s）'])
    hover=(float(relay['悬停功率（kW）'])+float(relay['通信附加功率（kW）']))/3600
    options=[]
    for c in candidates:
        local={}
        ds=sorted((byid[k] for k in c['covered_demands']),key=lambda d:(d['start_s'],d['end_s']))
        if not ds:continue
        # 每个300秒时带保留最早开始；长空档可独立产生下一架次。
        indices=[];buckets=set()
        for i,d in enumerate(ds):
            bucket=int(d['start_s']//300)
            if bucket not in buckets or (i and d['start_s']-ds[i-1]['end_s']>180):
                buckets.add(bucket);indices.append(i)
        if len(indices)>32:
            step=(len(indices)-1)/31
            indices=sorted({indices[round(k*step)] for k in range(32)})
        for i in indices:
            a=ds[i]['start_s']
            start=max(0,math.floor((a-prep-c['out_s']-link)*1000-1e-7)/1000)
            ready=start+prep+c['out_s']+link
            if ready>a+1e-7:continue
            max_end=ready+(budget-c['flight_energy_kwh']-hover*link)/hover
            eligible=[d for d in ds[i:] if d['start_s']>=ready-1e-7 and d['end_s']<=max_end+1e-9]
            if not eligible:continue
            ends=[]
            for duration in (250,500,750,1000,1500,2500,math.inf):
                avail=[d for d in eligible if d['end_s']<=a+duration]
                if avail:ends.append(max(d['end_s'] for d in avail))
            # 转场前的精确收班时刻不能被粗时间档吞掉。尤其两个中继站
            # 相隔数百秒飞行时，数十秒的额外悬停足以使硬时限不可行。
            by_sortie=defaultdict(list)
            for d in eligible:by_sortie[d['sortie_id']].append(d['end_s'])
            ends.extend(max(v) for v in by_sortie.values())
            # 最近 1500 秒内的各需求终点也保留：不同路线的需求可能
            # 交错出现，仅按架次末端截断会遗漏实际可转场的短窗口。
            ends.extend(d['end_s'] for d in eligible if d['end_s']<=a+1500)
            for end in sorted(set(ends)):
                covered=tuple(sorted(d['demand_id'] for d in eligible if d['end_s']<=end+1e-9))
                if not covered:continue
                service=end-ready
                e=relay_energy(relay,c,service)
                if e>budget+1e-9:continue
                soc=1-e/Euse
                ret=end+c['back_s'];full=ret+charging_time(soc,relay_charge)
                option={'candidate_id':c['id'],
                                'start_s':start,'arrival_s':start+prep+c['out_s'],
                                'link_ready_s':ready,'service_start_s':ready,
                                'service_end_s':end,'return_s':ret,
                                'uav_release_s':ret+turn,'component_full_s':full,
                                'energy_kwh':e,'return_soc':soc,
                                'covered_demands':covered,'candidate':c}
                old=local.get(covered)
                # 对同覆盖集保留占用更短、能量不高的服务窗，避免早启动劣解阻断排程。
                if old is None or (option['start_s']>=old['start_s']-1e-8 and
                                   option['component_full_s']<=old['component_full_s']+1e-8):
                    local[covered]=option
        for option in sorted(local.values(),key=lambda x:(x['start_s'],x['service_end_s'])):
            option['id']=f'RO{len(options)+1:05d}'
            options.append(option)
        if len(options)>=max_options:break
    return options


def solve_relay_options(options,demands,relay_uavs,relay_components,time_limit=90,
                        objective='feasible',hint=None,locks=None,transport_return_s=0,
                        enforce_uav=True,enforce_component=True):
    ids={d['demand_id'] for d in demands};coverage=defaultdict(list)
    for i,o in enumerate(options):
        for did in o['covered_demands']:coverage[did].append(i)
    missing=ids-set(coverage)
    if missing:return None,{'status':'UNCOVERED','missing':sorted(missing)}
    m=cp_model.CpModel();x=[m.NewBoolVar(f'x{i}') for i in range(len(options))]
    uvars=defaultdict(list);cvars=defaultdict(list)
    for did in ids:m.Add(sum(x[i] for i in coverage[did])>=1)
    for i,o in enumerate(options):
        uv=[];cv=[]
        for uid in relay_uavs:
            z=m.NewBoolVar(f'u{i}_{uid}');uv.append(z)
            s=math.floor(o['start_s']*1000);e=math.ceil(o['uav_release_s']*1000-1e-8)
            interval=m.NewOptionalIntervalVar(s,e-s,e,z,f'ui{i}_{uid}')
            uvars[uid].append(interval)
        for cid in relay_components:
            z=m.NewBoolVar(f'c{i}_{cid}');cv.append(z)
            s=math.floor(o['start_s']*1000);e=math.ceil(o['component_full_s']*1000-1e-8)
            interval=m.NewOptionalIntervalVar(s,e-s,e,z,f'ci{i}_{cid}')
            cvars[cid].append(interval)
        m.Add(sum(uv)==x[i]);m.Add(sum(cv)==x[i])
        o['_uv']=uv;o['_cv']=cv
    if enforce_uav:
        for group in uvars.values():m.AddNoOverlap(group)
    if enforce_component:
        for group in cvars.values():m.AddNoOverlap(group)
    end=m.NewIntVar(math.ceil(transport_return_s*1000),50_000_000,'joint_makespan_ms')
    for i,o in enumerate(options):m.Add(end>=math.ceil(o['return_s']*1000-1e-8)).OnlyEnforceIf(x[i])
    energy=sum(round(o['energy_kwh']*1e6)*x[i] for i,o in enumerate(options))
    locks=locks or {}
    if 'makespan_ms' in locks:m.Add(end<=locks['makespan_ms'])
    if 'energy_micro' in locks:m.Add(energy<=locks['energy_micro'])
    if 'sorties' in locks:m.Add(sum(x)<=locks['sorties'])
    if objective=='makespan':m.Minimize(end)
    elif objective=='energy':m.Minimize(energy)
    elif objective=='sorties':m.Minimize(sum(x))
    # 可行性轮不设置目标，优先让 CP-SAT 给出第一份排程。
    if hint:
        chosen={o['id'] for o in hint}
        for i,o in enumerate(options):
            if o['id'] in chosen:m.AddHint(x[i],1)
    solver=cp_model.CpSolver();solver.parameters.max_time_in_seconds=time_limit
    solver.parameters.num_search_workers=8;solver.parameters.random_seed=20260924
    status=solver.Solve(m)
    result={'status':solver.StatusName(status),'objective':objective,'runtime_s':solver.WallTime(),
            'best_bound':solver.BestObjectiveBound() if status in (cp_model.OPTIMAL,cp_model.FEASIBLE) else None}
    if status not in (cp_model.OPTIMAL,cp_model.FEASIBLE):return None,result
    chosen=[]
    for i,o in enumerate(options):
        if solver.Value(x[i]):
            record={k:v for k,v in o.items() if k not in ('candidate','_uv','_cv')}
            record.update({k:o['candidate'][k] for k in ['lon','lat','ground_m','agl_m','alt_m',
                       'out_s','back_s','flight_energy_kwh','backhaul_margin_db']})
            record['relay_uav_id']=relay_uavs[next(j for j,z in enumerate(o['_uv']) if solver.Value(z))]
            record['component_id']=relay_components[next(j for j,z in enumerate(o['_cv']) if solver.Value(z))]
            chosen.append(record)
    chosen.sort(key=lambda o:(o['start_s'],o['relay_uav_id']))
    for j,o in enumerate(chosen,1):o['sortie_id']=f'Q3-R{j:03d}'
    return chosen,result


def static_conflicts(candidates,demands,step=None):
    """在全部需求事件间隔精确判定同时覆盖，不依赖固定步长采样。"""
    all_ids=[d['demand_id'] for d in demands]
    pos={did:i for i,did in enumerate(all_ids)}
    masks=[]
    for c in candidates:
        mask=0
        for did in c['covered_demands']:
            if did in pos:mask|=1<<pos[did]
        masks.append(mask)
    events=sorted(set([d['start_s'] for d in demands]+[d['end_s'] for d in demands]))
    rows=[]
    for a,b in zip(events,events[1:]):
        t=(a+b)/2
        active=[d for d in demands if d['start_s']<=t<d['end_s']]
        if not active:continue
        target=sum(1<<pos[d['demand_id']] for d in active)
        if any(m&target==target for m in masks):needed=1
        elif any((a|b)&target==target for i,a in enumerate(masks) for b in masks[i+1:]):needed=2
        else:needed=3
        rows.append({'start_s':a,'end_s':b,'time_s':float(t),'active_demands':len(active),
                     'active_sorties':','.join(sorted({d['sortie_id'] for d in active})),
                     'minimum_relay_locations_lower_bound':needed})
    return rows


def shifted_transport(base_items,shift,nodes,boxes,models,charge,terrain,keep_zero_tardiness=True):
    """对固定 Q2 批次做可解释错峰，向后传递同机和同电池的占用冲突。"""
    items=[dict(x) for x in base_items]
    uav_ready=defaultdict(float);battery_ready=defaultdict(float)
    routes=[]
    for item in items:
        item['start_s']=max(item['start_s']+shift.get(item['sortie_id'],0),
                            uav_ready[item['uav_id']],battery_ready[item['battery_id']])
        route=reconstruct_transport(item,nodes,boxes,models,charge,terrain)
        for bid,delivered in route['deliveries'].items():
            b=boxes[bid]
            if b['hard_deadline'] is not None and delivered>b['hard_deadline']+1e-8:return None,None
            if keep_zero_tardiness and b['hard_deadline'] is None and delivered>b['expected']+1e-8:return None,None
        uav_ready[item['uav_id']]=route['return_s']
        battery_ready[item['battery_id']]=route['full_s']
        routes.append(route)
    return items,routes


def targeted_rebatch_schedule(base_items,nodes,boxes,models,charge,terrain,uavs,batteries):
    """在 Q2 冻结副本上尝试可追溯的同区并批与资源重排。

    S007 医疗箱并入同区早送箱；其余任务只调整开始时刻与实体资源。
    所有时限、电池充满和逐箱恰好一次由独立运输 Validator 复算。
    """
    items=[json.loads(json.dumps(x)) for x in base_items if x['sortie_id']!='Q3-T012']
    by={x['sortie_id']:x for x in items}
    by['Q3-T008']['candidate_key'][1][0][1].append('S007-MED-01')
    changes={
        'T014':(0,'U03','A_BAT_01'), 'T002':(2032,'U03','A_BAT_02'),
        'T015':(1800,'U01','A_BAT_04'),
        'T018':(4100,'U02','A_BAT_03'), 'T022':(5800,'U02','A_BAT_02'),
        'T005':(1837,'U07','C_BAT_03'), 'T020':(3879,'U07','C_BAT_01'),
        'T016':(3184,'U08','C_BAT_02'), 'T013':(5486,'U08','C_BAT_04'),
        'T023':(7795,'U08','C_BAT_03'), 'T017':(4164,'U05','B_BAT_03')}
    changes.update({'T010':(1880,'U06','B_BAT_02'),
                    'T019':(3882,'U06','B_BAT_04'),
                    'T021':(5441,'U06','B_BAT_01')})
    for short,(start,uid,bid) in changes.items():
        by['Q3-'+short].update(start_s=start,uav_id=uid,battery_id=bid)
    items.sort(key=lambda x:(x['start_s'],x['sortie_id']))
    uav_ready=defaultdict(float);battery_ready=defaultdict(float);routes=[]
    for item in items:
        item['start_s']=max(item['start_s'],uav_ready[item['uav_id']],battery_ready[item['battery_id']])
        route=reconstruct_transport(item,nodes,boxes,models,charge,terrain)
        uav_ready[item['uav_id']]=route['return_s']
        battery_ready[item['battery_id']]=route['full_s']
        routes.append(route)
    _,counts,errors=validate_transport(items,nodes,boxes,models,uavs,batteries,charge,terrain)
    if errors or any(v for k,v in counts.items() if k not in ('boxes_total','boxes_delivered')):
        raise RuntimeError(f'定向重排的运输独立验证失败：{counts}, {errors}')
    return items,routes


def turnover_seed_options(candidates,demands,relay,relay_charge):
    """由转场诊断生成四个显式服务窗，交给同一个 CP-SAT 与 Validator。

    顺序为中心走廊、远端走廊、S002/S004 走廊、远端走廊。
    时间仅是可行解 warm start，绝非官方物理常数或最优性结论。
    """
    windows=[(0,0.,3385.),(1,0.,1250.),(2,2090.,4900.),(1,4137.,9380.)]
    out=[];prep=float(relay['工位固定准备时间（s）']);link=float(relay['建链时间（s）'])
    turn=float(relay['架次周转时间（s）']);Euse=float(relay['能源组件可用能量（kWh）'])
    rho=float(relay['返航电量下限（%）'])/100
    for j,start,end in windows:
        c=candidates[j];ready=start+prep+c['out_s']+link
        energy=relay_energy(relay,c,end-ready)
        if energy>Euse*(1-rho)+1e-9:raise RuntimeError('转场种子能量越界')
        soc=1-energy/Euse;ret=end+c['back_s']
        covered=tuple(sorted(d['demand_id'] for d in demands if
            d['demand_id'] in c['covered_demands'] and d['start_s']>=ready-1e-8 and
            d['end_s']<=end+1e-8))
        out.append({'id':f'TURNOVER{len(out)+1}','candidate_id':c['id'],
            'start_s':start,'arrival_s':start+prep+c['out_s'],
            'link_ready_s':ready,'service_start_s':ready,'service_end_s':end,
            'return_s':ret,'uav_release_s':ret+turn,
            'component_full_s':ret+charging_time(soc,relay_charge),
            'energy_kwh':energy,'return_soc':soc,'covered_demands':covered,'candidate':c})
    return out


def local_refinement_compare(active,demands,routes,terrain,comm,gw,relay,nodes):
    """围绕已验证的中继位置进行 100 m / 25 m 局部加密并比较覆盖冗余。"""
    raw=[];seen=set();max_agl=float(relay['最大悬停离地高度（m）'])
    for base in active:
        cx,cy=TR.transform(base['lon'],base['lat'])
        for dx,dy in ((0,0),(100,0),(-100,0),(0,100),(0,-100)):
            lon,lat=INV_TR.transform(cx+dx,cy+dy)
            for agl in sorted({base['agl_m'],base['agl_m']-25,base['agl_m']+25}):
                if not 0<agl<=max_agl:continue
                key=(round(lon,7),round(lat,7),agl)
                if key in seen:continue
                seen.add(key)
                try:f=relay_flight(terrain,nodes,relay,lon,lat,agl)
                except ValueError:continue
                if f is not None:f['reason']='local_100m_25m';raw.append(f)
    fine,links=coverage_matrix(raw,demands,routes,terrain,comm,gw,relay)
    coarse_links=defaultdict(list)
    for c in active:
        for did in c['covered_demands']:coarse_links[did].append(c['id'])
    rows=[{'density':'coarse_verified_sites','physical_candidates':len(active),
           'covered_demands':len(coarse_links),'minimum_choices_per_demand':
           min((len(coarse_links.get(d['demand_id'],[])) for d in demands),default=0),
           'maximum_single_site_coverage':max((len(c['covered_demands']) for c in active),default=0)},
          {'density':'local_refined_100m_25m','physical_candidates':len(fine),
           'covered_demands':len(links),'minimum_choices_per_demand':
           min((len(links.get(d['demand_id'],[])) for d in demands),default=0),
           'maximum_single_site_coverage':max((len(c['covered_demands']) for c in fine),default=0)}]
    write_csv('q3_candidate_density_comparison.csv',rows)
    write_csv('q3_local_refinement.csv',[{'candidate_id':c['id'],'lon':c['lon'],
        'lat':c['lat'],'agl_m':c['agl_m'],'backhaul_margin_db':c['backhaul_margin_db'],
        'covered_demands':len(c['covered_demands'])} for c in fine])
    return rows


def candidate_transport_shifts(base_items,base_demands,candidates,nodes,boxes,models,charge,terrain,
                               comm,gw,keep_zero_tardiness=True):
    base=static_conflicts(candidates,base_demands)
    base_score=sum((x['end_s']-x['start_s'])*max(0,x['minimum_relay_locations_lower_bound']-2)
                   for x in base)
    affected=Counter()
    for row in base:
        if row['minimum_relay_locations_lower_bound']>2:
            affected.update(row['active_sorties'].split(','))
    if not affected:
        affected.update(d['sortie_id'] for d in sorted(base_demands,key=lambda d:d['start_s'])[:20])
    proposals=[]
    for sid,_ in affected.most_common(12):
        for amount in (300,600,900,1200,1500,1800,2100):
            items,routes=shifted_transport(base_items,{sid:amount},nodes,boxes,models,charge,terrain,
                                           keep_zero_tardiness)
            if items is None:continue
            shifts={new['sortie_id']:new['start_s']-old['start_s']
                    for new,old in zip(routes,base_items)}
            dem=[]
            for d in base_demands:
                dx=shifts[d['sortie_id']]
                new=dict(d);new['start_s']+=dx;new['end_s']+=dx
                dem.append(new)
            score=sum((x['end_s']-x['start_s'])*max(0,x['minimum_relay_locations_lower_bound']-2)
                      for x in static_conflicts(candidates,dem))
            proposals.append({'sortie_id':sid,'shift_s':amount,'score':score,'improvement':base_score-score,
                              'items':items,'routes':routes,'demands':dem})
    proposals.sort(key=lambda x:(x['score'],x['shift_s'],x['sortie_id']))
    return base_score,proposals


def validate_transport(items,nodes,boxes,models,uavs,batteries,charge,terrain):
    routes=[];counts=Counter();violations=[];coverage=Counter()
    for item in items:
        try:r=reconstruct_transport(item,nodes,boxes,models,charge,terrain)
        except Exception as exc:
            violations.append(f"{item['sortie_id']}: {exc}");counts['transport_physics_violations']+=1
            continue
        if r['uav_id'] not in uavs[r['g']] or r['battery_id'] not in batteries[r['g']]:
            counts['transport_resource_type_violations']+=1
        if r['start_s']<0:counts['transport_negative_start']+=1
        for bid,t in r['deliveries'].items():
            coverage[bid]+=1;b=boxes[bid]
            if b['hard_deadline'] is not None and t>b['hard_deadline']+1e-8:
                if b['category']=='医疗物资':counts['medical_deadline_violations']+=1
                if b['first']:counts['first_batch_deadline_violations']+=1
        routes.append(r)
    for resource,key,endkey,label in [(sum(uavs.values(),[]),'uav_id','return_s','transport_uav_overlap'),
                                      (sum(batteries.values(),[]),'battery_id','full_s','transport_battery_overlap')]:
        for rid in resource:
            entries=sorted((r for r in routes if r[key]==rid),key=lambda r:r['start_s'])
            for a,b in zip(entries,entries[1:]):
                if b['start_s']<a[endkey]-1e-8:counts[label]+=1
    counts['boxes_missing']=len(set(boxes)-set(coverage))
    counts['boxes_duplicated']=sum(v-1 for v in coverage.values() if v>1)
    counts['boxes_total']=len(boxes)
    counts['boxes_delivered']=sum(coverage.values())
    return routes,dict(counts),violations


def validate_relay(relay_sorties,terrain,nodes,relay,relay_uavs,relay_components,relay_charge,comm,gw):
    counts=Counter();fresh=[];Euse=float(relay['能源组件可用能量（kWh）']);rho=float(relay['返航电量下限（%）'])/100
    prep=float(relay['工位固定准备时间（s）']);link=float(relay['建链时间（s）'])
    turn=float(relay['架次周转时间（s）'])
    for r in relay_sorties:
        try:f=relay_flight(terrain,nodes,relay,float(r['lon']),float(r['lat']),float(r['agl_m']))
        except Exception:f=None
        if f is None:counts['relay_geometry_violations']+=1;continue
        start=float(r['start_s']);arrival=start+prep+f['out_s'];ready=arrival+link
        end=float(r['service_end_s']);ret=end+f['back_s']
        e=relay_energy(relay,f,end-ready);soc=1-e/Euse
        if start<0 or end<ready-1e-8:counts['relay_ready_time_violations']+=1
        if f['agl_m']>float(relay['最大悬停离地高度（m）'])+1e-9:counts['relay_AGL_violations']+=1
        if e> Euse*(1-rho)+1e-8:counts['relay_energy_violations']+=1
        if r['relay_uav_id'] not in relay_uavs or r['component_id'] not in relay_components:
            counts['relay_type_mismatch']+=1
        if not evaluate_link(terrain,comm,'RB',(f['lon'],f['lat'],f['alt_m']),'G',gw)['available']:
            counts['relay_backhaul_violations']+=1
        if abs(float(r['energy_kwh'])-e)>1e-8 or abs(float(r['return_s'])-ret)>1e-7:
            counts['relay_recalculation_mismatch']+=1
        fresh.append({**r,'arrival_s':arrival,'link_ready_s':ready,'return_s':ret,
                      'uav_release_s':ret+turn,'component_full_s':ret+charging_time(soc,relay_charge),
                      'energy_kwh':e,'return_soc':soc,'flight_energy_kwh':f['flight_energy_kwh']})
    for resources,key,endkey,label in [(relay_uavs,'relay_uav_id','uav_release_s','relay_uav_overlap'),
                                       (relay_components,'component_id','component_full_s','relay_component_overlap')]:
        for rid in resources:
            entries=sorted((r for r in fresh if r[key]==rid),key=lambda r:r['start_s'])
            for a,b in zip(entries,entries[1:]):
                if b['start_s']<a[endkey]-1e-8:counts[label]+=1
    return fresh,dict(counts)


def source_certificate(terrain,comm,phase,a,b,station,code):
    clear,blocked=link_radii(comm,'T',code)
    # 投影曲率与浮点计算采用 1% 距离外扩，仅会降低认证率。
    dmax=distance_upper_on_phase(phase,a,b,station)*1.01+0.01
    lim=link_budget(comm,'T',code)
    if dmax<=blocked:
        margin=lim-(32.45+20*math.log10(comm['freq'])+20*math.log10(dmax/1000)+comm['obs_loss'])
        return margin if margin>=0 else None
    if phase['p0']==phase['p1']:
        p=evaluate_link(terrain,comm,'T',phase['p0'],code,station)
        return p['margin_db'] if p['available'] else None
    if dmax<=clear and swept_clear(terrain,phase,a,b,station):
        margin=lim-(32.45+20*math.log10(comm['freq'])+20*math.log10(dmax/1000))
        return margin if margin>=0 else None
    return None


def certify_communication(routes,relay_sorties,terrain,comm,gw,min_dt=0.005,
                          robust_source_preference=False):
    """最终 Validator：阶段、切换点和自适应时段全覆盖；未知即不通过。"""
    results=[];counts=Counter();nodes_checked=0
    back={r['sortie_id']:evaluate_link(terrain,comm,'RB',
          (r['lon'],r['lat'],r['alt_m']),'G',gw)['margin_db'] for r in relay_sorties}
    def check(phase,a,b,active,depth=0):
        nonlocal nodes_checked
        nodes_checked+=1
        # 稳健化仅改变可用保障来源的选择。T016 此巡航段在 4000 s 后
        # 使用已有 R003；传播损耗、链路预算和 DEM 认证公式均保持不变。
        prefer_relay=(robust_source_preference and phase.get('kind')=='cruise' and
                      abs(phase['start']-3772.215666503906)<0.01 and b>4000.0)
        margin=None if prefer_relay else source_certificate(terrain,comm,phase,a,b,gw,'G')
        if margin is not None:return [(a,b,'DIRECT','',margin)]
        for r in active:
            if back[r['sortie_id']]<0:continue
            pos=(r['lon'],r['lat'],r['alt_m'])
            access=source_certificate(terrain,comm,phase,a,b,pos,'RA')
            if access is not None:return [(a,b,'RELAY',r['sortie_id'],min(access,back[r['sortie_id']]))]
        if b-a<=min_dt or depth>=25:
            mid=(a+b)/2;pos=phase_position(phase,mid)
            available=evaluate_link(terrain,comm,'T',pos,'G',gw)['available']
            if not available:
                available=any(back[r['sortie_id']]>=0 and evaluate_link(
                    terrain,comm,'T',pos,'RA',(r['lon'],r['lat'],r['alt_m']))['available'] for r in active)
            return [(a,b,'UNCERTIFIED' if available else 'OUTAGE','',float('-inf'))]
        mid=(a+b)/2
        return check(phase,a,mid,active,depth+1)+check(phase,mid,b,active,depth+1)
    for route in routes:
        for pi,phase in enumerate(route['phases']):
            events={phase['start'],phase['end']}
            for r in relay_sorties:
                for t in (r['link_ready_s'],r['service_end_s']):
                    if phase['start']<t<phase['end']:events.add(t)
            ticks=sorted(events)
            for a,b in zip(ticks,ticks[1:]):
                active=[r for r in relay_sorties if r['link_ready_s']<=a+1e-8 and r['service_end_s']>=b-1e-8]
                for s,e,mode,rid,margin in check(phase,a,b,active):
                    if results and results[-1]['transport_sortie_id']==route['sortie_id'] and \
                       results[-1]['phase_index']==pi and results[-1]['mode']==mode and \
                       results[-1]['relay_sortie_id']==rid and abs(results[-1]['end_s']-s)<1e-8:
                        results[-1]['end_s']=e
                        results[-1]['minimum_certified_margin_db']=min(results[-1]['minimum_certified_margin_db'],margin)
                    else:
                        results.append({'transport_sortie_id':route['sortie_id'],'phase_index':pi,
                                        'phase':phase['kind'],'start_s':s,'end_s':e,'mode':mode,
                                        'relay_sortie_id':rid,'minimum_certified_margin_db':margin})
            # 所有阶段端点也单独检查通信来源，避免相邻开区间掩盖瞬时断链。
            for t in (phase['start'],phase['end']):
                p=phase_position(phase,t)
                direct=evaluate_link(terrain,comm,'T',p,'G',gw)['available']
                rel=any(r['link_ready_s']-1e-8<=t<=r['service_end_s']+1e-8 and
                        back[r['sortie_id']]>=0 and evaluate_link(terrain,comm,'T',p,'RA',
                        (r['lon'],r['lat'],r['alt_m']))['available'] for r in relay_sorties)
                if not (direct or rel):counts['phase_boundary_violations']+=1
    for r in results:
        if r['mode']=='OUTAGE':counts['communication_outage_duration_upper_bound_s']+=r['end_s']-r['start_s']
        if r['mode']=='UNCERTIFIED':counts['uncertified_duration_s']+=r['end_s']-r['start_s']
    for left,right in zip(results,results[1:]):
        if left['transport_sortie_id']==right['transport_sortie_id'] and \
           left['phase_index']==right['phase_index'] and abs(left['end_s']-right['start_s'])>1e-7:
            counts['handover_violations']+=1
    counts['minimum_certified_link_margin_db']=min((r['minimum_certified_margin_db'] for r in results
                                                    if r['mode'] in ('DIRECT','RELAY')),default=float('-inf'))
    counts['certification_nodes_checked']=nodes_checked
    return results,dict(counts)


def sampling_convergence(routes,intervals,relay_sorties,terrain,comm,gw):
    relay_by_id={r['sortie_id']:r for r in relay_sorties}
    phase_map={(r['sortie_id'],i):p for r in routes for i,p in enumerate(r['phases'])}
    rows=[]
    for step in (10,5,2.5):
        minimum=math.inf;bad=0;samples=0
        for row in intervals:
            if row['mode'] not in ('DIRECT','RELAY'):continue
            p=phase_map[row['transport_sortie_id'],row['phase_index']]
            x0,y0=TR.transform(*phase_position(p,row['start_s'])[:2])
            x1,y1=TR.transform(*phase_position(p,row['end_s'])[:2])
            dist=math.hypot(x1-x0,y1-y0)
            n=max(1,math.ceil(dist/step),math.ceil((row['end_s']-row['start_s'])/step))
            for k in range(n+1):
                t=row['start_s']+(row['end_s']-row['start_s'])*k/n
                pos=phase_position(p,t)
                if row['mode']=='DIRECT':margin=evaluate_link(terrain,comm,'T',pos,'G',gw)['margin_db']
                else:
                    r=relay_by_id[row['relay_sortie_id']];rp=(r['lon'],r['lat'],r['alt_m'])
                    margin=min(evaluate_link(terrain,comm,'T',pos,'RA',rp)['margin_db'],
                               evaluate_link(terrain,comm,'RB',rp,'G',gw)['margin_db'])
                minimum=min(minimum,margin);bad+=margin<-1e-8;samples+=1
        rows.append({'spacing_m':step,'samples':samples,'minimum_sampled_margin_db':minimum,
                     'unavailable_samples':bad})
    rows[-1]['last_two_margin_difference_db']=abs(rows[-1]['minimum_sampled_margin_db']-
                                               rows[-2]['minimum_sampled_margin_db'])
    return rows


def q4_precheck(routes,relay_sorties,intervals):
    parent={f'S{i:03d}':f'S{i:03d}' for i in range(1,16)}
    def find(x):
        while parent[x]!=x:
            parent[x]=parent[parent[x]];x=parent[x]
        return x
    def union(a,b):parent[find(a)]=find(b)
    route_services={r['sortie_id']:{sid for sid,_ in r['groups']} for r in routes}
    for services in route_services.values():
        for sid in services:union(sorted(services)[0],sid)
    relay_routes=defaultdict(set)
    for row in intervals:
        if row['mode']=='RELAY':relay_routes[row['relay_sortie_id']].add(row['transport_sortie_id'])
    for targets in relay_routes.values():
        services=set().union(*(route_services[sid] for sid in targets)) if targets else set()
        for sid in services:union(sorted(services)[0],sid)
    groups=defaultdict(list)
    for s in parent:groups[find(s)].append(s)
    return {'component_count':len(groups),'K3_possible':len(groups)>=3,
            'components':list(sorted(v) for v in groups.values())}


def solution_metrics(routes,relay_sorties,boxes):
    arrivals={bid:t for r in routes for bid,t in r['deliveries'].items()}
    tardy=sum(max(0,arrivals[bid]-b['expected']) for bid,b in boxes.items()
              if b['hard_deadline'] is None and bid in arrivals)
    transport_energy=sum(r['energy_kwh'] for r in routes)
    relay_energy_total=sum(r['energy_kwh'] for r in relay_sorties)
    return {'ordinary_total_tardiness_s':tardy,
            'ordinary_late_boxes':sum(arrivals[bid]>b['expected']+1e-8 for bid,b in boxes.items()
                                      if b['hard_deadline'] is None and bid in arrivals),
            'joint_makespan_s':max([r['return_s'] for r in routes]+[r['return_s'] for r in relay_sorties]),
            'transport_energy_kwh':transport_energy,'relay_energy_kwh':relay_energy_total,
            'total_energy_kwh':transport_energy+relay_energy_total,
            'transport_sorties':len(routes),'relay_sorties':len(relay_sorties),
            'total_sorties':len(routes)+len(relay_sorties)}


def validate_q3(items,relay_sorties,nodes,boxes,models,uavs,batteries,charge,terrain,
                relay,relay_uavs,relay_components,relay_charge,comm,gw,run_sampling=True,
                robust_source_preference=False):
    routes,tc,tv=validate_transport(items,nodes,boxes,models,uavs,batteries,charge,terrain)
    rr,rc=validate_relay(relay_sorties,terrain,nodes,relay,relay_uavs,relay_components,relay_charge,comm,gw)
    intervals,cc=certify_communication(routes,rr,terrain,comm,gw,
                                      robust_source_preference=robust_source_preference)
    convergence=sampling_convergence(routes,intervals,rr,terrain,comm,gw) if run_sampling else []
    combined={**tc,**rc,**cc}
    if convergence:
        combined['sampling_converged']=convergence[-1]['last_two_margin_difference_db']<=0.1 and all(
            row['unavailable_samples']==0 for row in convergence)
    failures={k:v for k,v in combined.items() if k.endswith('_violations') or k in
              ('boxes_missing','boxes_duplicated','communication_outage_duration_upper_bound_s',
               'uncertified_duration_s','transport_uav_overlap','transport_battery_overlap',
               'relay_uav_overlap','relay_component_overlap') if v}
    valid=not failures and combined.get('boxes_delivered')==80 and \
        combined.get('minimum_certified_link_margin_db',-math.inf)>=0 and \
        (not run_sampling or combined.get('sampling_converged',False))
    combined['Q3_VALID']=valid;combined['failures']=failures;combined['transport_violations']=tv
    return {'routes':routes,'relay_sorties':rr,'intervals':intervals,
            'validation':combined,'sampling_convergence':convergence,
            'metrics':solution_metrics(routes,rr,boxes)}


def transport_tables(routes,boxes):
    route_rows=[];box_rows=[];uav_rows=[];battery_rows=[]
    for r in routes:
        route_rows.append({'sortie_id':r['sortie_id'],'uav_id':r['uav_id'],'aircraft_type':r['g'],
                           'battery_id':r['battery_id'],'start_s':r['start_s'],'takeoff_s':r['takeoff_s'],
                           'service_sequence':','.join(sid for sid,_ in r['groups']),
                           'box_ids':','.join(r['box_ids']),'box_count':len(r['box_ids']),
                           'mass_kg':r['mass_kg'],'volume_m3':r['volume_m3'],
                           'return_s':r['return_s'],'energy_kwh':r['energy_kwh'],
                           'return_soc':r['return_soc']})
        uav_rows.append({'sortie_id':r['sortie_id'],'uav_id':r['uav_id'],'type':r['g'],
                         'start_s':r['start_s'],'return_s':r['return_s']})
        battery_rows.append({'sortie_id':r['sortie_id'],'battery_id':r['battery_id'],'type':r['g'],
                             'occupation_start_s':r['start_s'],'charge_start_s':r['return_s'],
                             'full_ready_s':r['full_s'],'return_soc':r['return_soc']})
        for bid,t in r['deliveries'].items():
            b=boxes[bid]
            box_rows.append({'box_id':bid,'sortie_id':r['sortie_id'],'service_id':b['service'],
                             'category':b['category'],'delivery_complete_s':t,
                             'expected_s':b['expected'],'hard_deadline_s':b['hard_deadline'],
                             'tardiness_s':max(0,t-b['expected']) if b['hard_deadline'] is None else 0})
    box_rows.sort(key=lambda x:x['box_id'])
    return route_rows,box_rows,uav_rows,battery_rows


def relay_tables(relay_sorties):
    rows=[];uav_rows=[];component_rows=[]
    for r in relay_sorties:
        rows.append({k:r[k] for k in ['sortie_id','relay_uav_id','component_id','start_s','arrival_s',
                    'link_ready_s','service_start_s','service_end_s','return_s','lon','lat','ground_m',
                    'agl_m','alt_m','flight_energy_kwh','energy_kwh','return_soc']})
        uav_rows.append({'sortie_id':r['sortie_id'],'relay_uav_id':r['relay_uav_id'],
                         'start_s':r['start_s'],'return_s':r['return_s'],
                         'release_s':r['uav_release_s']})
        component_rows.append({'sortie_id':r['sortie_id'],'component_id':r['component_id'],
                               'start_s':r['start_s'],'charge_start_s':r['return_s'],
                               'full_ready_s':r['component_full_s'],'return_soc':r['return_soc']})
    return rows,uav_rows,component_rows


def add_sheet(book,title,rows):
    sheet=book.create_sheet(title)
    if not rows:return
    cols=list(rows[0]);sheet.append(cols)
    for row in rows:
        sheet.append([','.join(map(str,row[c])) if isinstance(row[c],list) else row[c] for c in cols])
    sheet.freeze_panes='A2';sheet.auto_filter.ref=sheet.dimensions
    for cell in sheet[1]:
        cell.font=Font(bold=True,color='FFFFFF')
        cell.fill=PatternFill('solid',fgColor='17365D')
    for j,col in enumerate(cols,1):
        sheet.column_dimensions[get_column_letter(j)].width=min(45,max(14,len(col)*1.8))
        for cells in sheet.iter_cols(min_col=j,max_col=j,min_row=2):
            for cell in cells:
                if isinstance(cell.value,float):cell.number_format='0.000000000'


def save_workbook(path,tables):
    book=Workbook();book.remove(book.active)
    for name,rows in tables:add_sheet(book,name,rows)
    book.save(path)


def sheet_fingerprint(sheet):
    return tuple((row[0].coordinate,row[0].value,row[0].data_type,row[0].number_format)
                 for row in ((cell,) for cells in sheet.iter_rows() for cell in cells))


def official_template(relay_rows,intervals,route_rows,box_rows):
    src=Q2/'结果提交模板_Q1Q2_优化版.xlsx'
    target=OUT/'结果提交模板_Q1Q2Q3已填写.xlsx'
    w=load_workbook(src)
    preserved={s:sheet_fingerprint(w[s]) for s in
               ['Q1_单点组批','Q2_运输架次','Q2_逐箱交付','Q4_分区配置']}
    s=w['Q3_中继架次']
    for i,r in enumerate(relay_rows,2):
        values=[r['sortie_id'],r['relay_uav_id'],r['component_id'],r['start_s'],r['lon'],
                r['lat'],r['alt_m'],r['link_ready_s'],r['service_end_s'],r['return_s'],r['energy_kwh']]
        for j,v in enumerate(values,1):s.cell(i,j).value=v
    s=w['Q3_通信保障']
    for i,r in enumerate(intervals,2):
        vals=[r['transport_sortie_id'],r['phase'],r['start_s'],r['end_s'],r['mode'],r['relay_sortie_id']]
        for j,v in enumerate(vals,1):s.cell(i,j).value=v
    w.save(target)
    w2=load_workbook(target,read_only=False,data_only=False)
    unchanged=all(sheet_fingerprint(w2[s])==preserved[s] for s in preserved)
    relay_ids={r['sortie_id'] for r in relay_rows};transport_ids={r['sortie_id'] for r in route_rows}
    actual_relays=[tuple(w2['Q3_中继架次'].cell(i,j).value for j in range(1,12))
                   for i in range(2,2+len(relay_rows))]
    actual_comm=[tuple(w2['Q3_通信保障'].cell(i,j).value for j in range(1,7))
                 for i in range(2,2+len(intervals))]
    okay=unchanged and len(actual_relays)==len(relay_rows) and len(actual_comm)==len(intervals)
    okay &= all(row[0] in relay_ids and abs(row[10]-relay_rows[i]['energy_kwh'])<1e-9
                for i,row in enumerate(actual_relays))
    okay &= all(row[0] in transport_ids and (row[4]!='RELAY' or row[5] in relay_ids)
                for row in actual_comm)
    w2.close()
    supplement=OUT/'Q3_运输补充明细.xlsx'
    tr=transport_tables_from_rows(route_rows,box_rows)
    save_workbook(supplement,tr)
    s2=load_workbook(supplement,read_only=True,data_only=True)
    supplement_ok=len(list(s2['Q3_逐箱交付'].iter_rows(min_row=2,values_only=True)))==80 and \
        {r[0] for r in s2['Q3_逐箱交付'].iter_rows(min_row=2,values_only=True)}=={r['box_id'] for r in box_rows}
    s2.close()
    return {'official_template_export':'PASS' if okay else 'FAIL',
            'Q1_Q2_sheets_unchanged':unchanged,
            'supplementary_transport_export':'PASS' if supplement_ok else 'FAIL',
            'excel_roundtrip':'PASS' if okay and supplement_ok else 'FAIL'}


def transport_tables_from_rows(route_rows,box_rows):
    return [('Q3_运输架次',route_rows),('Q3_逐箱交付',box_rows),
            ('Q3_运输UAV',[{'sortie_id':r['sortie_id'],'uav_id':r['uav_id'],
                           'start_s':r['start_s'],'return_s':r['return_s']} for r in route_rows]),
            ('Q3_运输电池',[{'sortie_id':r['sortie_id'],'battery_id':r['battery_id'],
                           'start_s':r['start_s'],'return_s':r['return_s']} for r in route_rows])]


def make_figures(nodes,routes,relay_sorties,intervals,blind,refinement):
    figdir=OUT/'figures';figdir.mkdir(exist_ok=True)
    def save(name):
        plt.tight_layout();plt.savefig(figdir/name,dpi=170);plt.close()
    plt.figure(figsize=(8,7))
    for r in routes:
        seq=['O01']+[s for s,_ in r['groups']]+['O01']
        plt.plot([nodes[s]['lon'] for s in seq],[nodes[s]['lat'] for s in seq],color='steelblue',alpha=.25)
    plt.scatter([n['lon'] for n in nodes.values()],[n['lat'] for n in nodes.values()],s=15,c='black')
    plt.scatter([r['lon'] for r in relay_sorties],[r['lat'] for r in relay_sorties],c='red',marker='^')
    plt.title('Q3 transport routes and relay positions');plt.xlabel('Longitude');plt.ylabel('Latitude')
    save('q3_transport_routes_map.png')
    plt.figure(figsize=(10,5))
    for d in blind:plt.plot([d['start_s'],d['end_s']],[int(d['sortie_id'][-3:])]*2,color='firebrick')
    plt.title('Frozen Q2 direct blind intervals');plt.xlabel('Time (s)');plt.ylabel('Sortie')
    save('q3_direct_blind_intervals.png')
    plt.figure(figsize=(9,5))
    plt.scatter([r['lon'] for r in relay_sorties],[r['lat'] for r in relay_sorties],
                c=[r['agl_m'] for r in relay_sorties],cmap='viridis',s=70)
    plt.colorbar(label='AGL (m)');plt.title('Selected relay hover locations');save('q3_relay_positions.png')
    plt.figure(figsize=(10,5))
    for i,r in enumerate(routes):plt.plot([r['start_s'],r['return_s']],[i]*2,color='steelblue')
    for j,r in enumerate(relay_sorties):plt.plot([r['start_s'],r['return_s']],[len(routes)+j]*2,color='firebrick')
    plt.title('Transport and relay UAV schedule');plt.xlabel('Time (s)');save('q3_transport_relay_gantt.png')
    plt.figure(figsize=(10,5))
    for r in intervals:
        plt.plot([r['start_s'],r['end_s']],[int(r['transport_sortie_id'][-3:])]*2,
                 color='steelblue' if r['mode']=='DIRECT' else 'firebrick')
    plt.title('Certified communication timeline');plt.xlabel('Time (s)');save('q3_communication_timeline.png')
    plt.figure(figsize=(8,4))
    plt.plot([r['start_s'] for r in intervals],[r['minimum_certified_margin_db'] for r in intervals],'.')
    plt.axhline(0,color='red');plt.title('Certified link margin lower bounds');plt.xlabel('Time (s)');plt.ylabel('dB')
    save('q3_link_margin.png')
    plt.figure(figsize=(10,3))
    for j,r in enumerate(relay_sorties):plt.plot([r['start_s'],r['component_full_s']],[j]*2)
    plt.title('Relay energy component occupation');plt.xlabel('Time (s)');save('q3_relay_component_gantt.png')
    plt.figure(figsize=(6,4))
    plt.plot([r['round'] for r in refinement],[r['candidate_count'] for r in refinement],marker='o')
    plt.title('Relay candidate refinement');plt.xlabel('Round');plt.ylabel('Candidates')
    save('q3_candidate_refinement.png')


def export_final(sol,boxes,nodes,blind,coverage_rows,candidates,refinement,conflicts,
                 baseline,stages,freeze,relay,comm,gw,local_density):
    routes=sol['routes'];relays=sol['relay_sorties'];intervals=sol['intervals']
    val=sol['validation'];metrics=sol['metrics']
    tr,br,tu,tb=transport_tables(routes,boxes)
    rr,ru,rc=relay_tables(relays)
    write_csv('q3_transport_routes.csv',tr)
    write_csv('q3_box_delivery.csv',br)
    write_csv('q3_transport_uav_timeline.csv',tu)
    write_csv('q3_transport_battery_timeline.csv',tb)
    write_csv('q3_relay_sorties.csv',rr)
    write_csv('q3_relay_uav_timeline.csv',ru)
    write_csv('q3_relay_component_timeline.csv',rc)
    write_csv('q3_communication_intervals.csv',intervals)
    write_csv('q3_link_margin.csv',[{'transport_sortie_id':r['transport_sortie_id'],
                                  'start_s':r['start_s'],'end_s':r['end_s'],
                                  'source':r['mode'],'margin_lower_bound_db':r['minimum_certified_margin_db']}
                                 for r in intervals])
    write_csv('q3_sampling_convergence.csv',sol['sampling_convergence'])
    write_csv('q3_baseline_comparison.csv',[
        {'scenario':'Q2_frozen_plus_relay','status':baseline['status'],
         **(baseline.get('metrics') or {})},
        {'scenario':'Q3_formal','status':'FEASIBLE',**metrics}])
    save_workbook(OUT/'q3_transport_routes.xlsx',[('Q3运输架次',tr)])
    save_workbook(OUT/'q3_box_delivery.xlsx',[('Q3逐箱交付',br)])
    save_workbook(OUT/'q3_relay_sorties.xlsx',[('Q3中继架次',rr)])
    save_workbook(OUT/'q3_communication_intervals.xlsx',[('Q3通信保障',intervals)])
    save_workbook(OUT/'q3_results.xlsx',[
        ('运输架次',tr),('逐箱交付',br),('中继架次',rr),('通信保障',intervals),
        ('运输UAV',tu),('运输电池',tb),('中继UAV',ru),('中继组件',rc),
        ('验证',list({'name':k,'value':v} for k,v in val.items() if not isinstance(v,(dict,list))))])
    excel=official_template(rr,intervals,tr,br)
    if excel['excel_roundtrip']!='PASS':raise RuntimeError('Q3 Excel 回读验证失败')
    q4=q4_precheck(routes,relays,intervals)
    summary={'Q1_FREEZE_INTEGRITY':'PASS','Q2_FREEZE_INTEGRITY':'PASS',
             'Q3_BASELINE_FROZEN_Q2_PLUS_RELAY':baseline['status'],
             'GATE2_Q3_COMM_FEASIBLE':'PASS' if val['Q3_VALID'] else 'FAIL',
             'Q3_VALID':val['Q3_VALID'],**metrics,
             'direct_blind_intervals':len(blind),
             'direct_blind_duration_s':sum(d['duration_s'] for d in blind),
             'baseline_three_location_conflict_intervals':len(conflicts),
             'relay_candidates_initial':refinement[0]['candidate_count'],
             'relay_candidates_final':len(candidates),
             'relay_uav_usage':dict(Counter(r['relay_uav_id'] for r in relays)),
             'relay_component_usage':dict(Counter(r['component_id'] for r in relays)),
             'direct_covered_duration_s':sum(r['end_s']-r['start_s'] for r in intervals if r['mode']=='DIRECT'),
             'relay_covered_duration_s':sum(r['end_s']-r['start_s'] for r in intervals if r['mode']=='RELAY'),
             'communication_outage_duration_upper_bound_s':val.get('communication_outage_duration_upper_bound_s',0),
             'uncertified_duration_s':val.get('uncertified_duration_s',0),
             'minimum_certified_link_margin_db':val['minimum_certified_link_margin_db'],
             'q4_precheck':q4,'objective_stages':stages,'excel':excel,
             'local_candidate_density':local_density,
             'sampling_convergence':sol['sampling_convergence'],
             'model_assumptions':['DECLARED_MODEL_ASSUMPTION: transport horizontal/climb energy',
                                  'DECLARED_RELAY_ENERGY_ASSUMPTION: link setup hover+communication power',
                                  'DECLARED_RELAY_VERTICAL_TRANSITION_ASSUMPTION: hover above terrain-clearance cruise via terminal vertical ascent/descent']}
    write_json('q3_solution.json',{'transport_items':sol['items'],'relay_sorties':relays,
                                    'metrics':metrics,'communication_intervals':intervals,
                                    'transport_routes':tr,'box_deliveries':br})
    write_json('q3_validation.json',val)
    write_json('q3_summary.json',summary)
    (OUT/'q3_validation.md').write_text('# Q3 独立验证\n\n'+
        '\n'.join(f'- {k}: {v}' for k,v in val.items() if not isinstance(v,(dict,list)))+'\n',encoding='utf-8')
    lines=['# 问题三求解结果','',
           '## Q1/Q2 冻结关系','Q2 V2 是无通信基准及 warm start；Q1/Q2 文件 SHA256 复核通过。',
           '## Q2 直连诊断',f"盲区 {len(blind)} 段，总长 {summary['direct_blind_duration_s']:.3f} s。",
           '## 冻结运输加中继基准',
           f"状态：{baseline['status']}；在本轮候选池内，有 {len(conflicts)} 个事件区间同时至少需要三处中继位置，官方仅有两架中继无人机。",
           '## 正式联合方案',
           f"普通物资逾期 {metrics['ordinary_total_tardiness_s']:.6f} s；联合完成时间 {metrics['joint_makespan_s']:.6f} s。",
           f"运输能耗 {metrics['transport_energy_kwh']:.9f} kWh；中继能耗 {metrics['relay_energy_kwh']:.9f} kWh。",
           f"运输架次 {metrics['transport_sorties']}；中继架次 {metrics['relay_sorties']}。",
           '## 通信认证',
           f"断链上界 {summary['communication_outage_duration_upper_bound_s']:.9f} s；未认证 {summary['uncertified_duration_s']:.9f} s。",
           f"最小认证 margin {summary['minimum_certified_link_margin_db']:.6f} dB。",
           '## 最优性边界',
           'F1=0 达到非负全局下界。F2/F3 的候选池数值最优解未通过连续通信 Validator，正式方案仅报告可行；F4 的候选池求解不能补足前层最优性证明。',
           '冻结 Q2 加中继的不可行结论限于本轮候选位置、服务窗与官方两架中继资源。',
           '## 候选点局部加密',
           f"粗层 {local_density[0]['physical_candidates']} 个位置、覆盖 {local_density[0]['covered_demands']} 段；细层 {local_density[1]['physical_candidates']} 个位置、覆盖 {local_density[1]['covered_demands']} 段。",
           '## 能耗口径',
           '运输水平与爬升展开式是 DECLARED_MODEL_ASSUMPTION；建链阶段按悬停加通信功率计能耗是 DECLARED_RELAY_ENERGY_ASSUMPTION；高悬停点到点额外垂直爬升是 DECLARED_RELAY_VERTICAL_TRANSITION_ASSUMPTION。',
           '## Q4 预检查',f"依赖连通分量 {q4['component_count']}，K=3 可分性 {q4['K3_possible']}（非 Q3 官方硬约束）。",
           '## Validator',f"Q3_VALID = {val['Q3_VALID']}；所有硬违规为 0。"]
    (OUT/'q3_summary.md').write_text('\n\n'.join(lines)+'\n',encoding='utf-8')
    (OUT/'q3_baseline_comparison.md').write_text('# Q3 基准比较\n\n'+
        f"冻结 Q2 加中继：{baseline['status']}；候选池内三位置冲突区间 {len(conflicts)} 个。\n\n"
        f"正式方案：{metrics}\n",encoding='utf-8')
    make_figures(nodes,routes,relays,intervals,blind,refinement)
    return summary


def main():
    print('==============================\nQ3 正式求解开始\n==============================',flush=True)
    OUT.mkdir(parents=True,exist_ok=True)
    (OUT/'figures').mkdir(exist_ok=True)
    log('[0/14] 核验 Gate-0、Q1/Q2 SHA256 冻结')
    freeze=upstream_freeze()
    read_official_q3_rules()
    log('[1/14] 读取官方通信、中继、运输和 DEM 数据')
    nodes,boxes,models,uavs,batteries,charge,relay,relay_uavs,relay_components,relay_charge,raw=load_inputs()
    terrain=Terrain();comm=comm_parameters(raw);gw=gateway(nodes,comm)
    base_items,base_routes=load_q2_transport(nodes,boxes,models,charge,terrain)
    log('[2/14] 重建 Q2 V2 三维运输轨迹并诊断直连')
    coverage_rows,blind=sample_direct(base_routes,terrain,comm,gw,60)
    pieces=partition_demands(blind,base_routes)
    write_csv('q3_q2_direct_coverage.csv',coverage_rows)
    write_csv('q3_direct_coverage.csv',coverage_rows)
    write_csv('q3_direct_blind_intervals.csv',blind)
    log(f'直连盲区 {len(blind)} 段、需求子区间 {len(pieces)} 段')
    log('[3/14] 生成并核验中继候选')
    cache_path=OUT/'q3_candidate_cache.json'
    cache_key={'q2_sha':sha(Q2/'best_validated_solution.json'),'blind_step_m':60,
               'piece_max_m':400,'algorithm':5}
    if cache_path.exists() and jd(cache_path).get('key')==cache_key:
        cached=jd(cache_path);candidates=cached['candidates'];links=cached['links']
        initial_count=cached['initial_count']
        log('从同版数据的 Q3 缓存恢复中继覆盖矩阵')
    else:
        original=candidate_locations(blind,nodes,terrain,relay);initial_count=len(original)
        candidates,links=coverage_matrix(original,pieces,base_routes,terrain,comm,gw,relay)
        log(f'初始三维候选 {initial_count}，筛选后 {len(candidates)}，覆盖 {len(links)}/{len(pieces)}')
        candidates,links,missing=fill_uncovered(candidates,links,pieces,nodes,terrain,comm,gw,relay,base_routes)
        log(f'定向补点后候选 {len(candidates)}，覆盖 {len(links)}/{len(pieces)}')
        atomic_json('q3_candidate_cache.json',{'key':cache_key,'initial_count':initial_count,
                                                'candidates':candidates,'links':links})
    write_csv('q3_relay_candidates.csv',[{k:v for k,v in c.items() if k not in ('out_seg','back_seg','covered_demands')}
                                          |{'covered_demand_count':len(c['covered_demands'])} for c in candidates])
    refinement=[{'round':0,'candidate_count':initial_count,'coverage_count':len(links)},
                {'round':1,'candidate_count':len(candidates),'coverage_count':len(links)}]
    write_csv('q3_relay_candidate_stats.csv',refinement)
    uncovered=[d['demand_id'] for d in pieces if d['demand_id'] not in links]
    if uncovered:
        write_csv('q3_conflicts.csv',[{'category':'NO_RELAY_COVERAGE','demand_id':x} for x in uncovered])
        raise RuntimeError(f'候选细化后仍有 {len(uncovered)} 个盲区子区间无中继覆盖')
    active,_=select_relay_candidates(candidates,pieces,12)
    log(f'[4/14] 稀疏覆盖关系完成，活动中继位置 {len(active)}')
    options=build_relay_options(active,pieces,relay,relay_charge)
    log(f'[5/14] Frozen-Q2 + Relay 基准，选项 {len(options)}')
    baseline_static=static_conflicts(candidates,pieces)
    if any(r['minimum_relay_locations_lower_bound']>2 for r in baseline_static):
        baseline_relay=None
        baseline_info={'status':'INFEASIBLE','reason':'同时段至少需要三处中继位置，而官方仅有两架中继无人机'}
    else:
        baseline_relay,baseline_info=solve_relay_options(options,pieces,relay_uavs,relay_components,
                                                          75,transport_return_s=max(r['return_s'] for r in base_routes))
    stages=[{'objective':'F1 ordinary tardiness','status':'OPTIMAL','value':0,
             'reason':'Q2 V2 零逾期已达非负目标下界，但仍需通信可行'}]
    baseline={'status':'INFEASIBLE' if baseline_relay is None else 'FEASIBLE',
              'solver':baseline_info}
    best=None;current_items=base_items;current_routes=base_routes;current_demands=pieces
    if baseline_relay is not None:
        test=validate_q3(base_items,baseline_relay,nodes,boxes,models,uavs,batteries,charge,
                         terrain,relay,relay_uavs,relay_components,relay_charge,comm,gw,False)
        baseline['validation']=test['validation']
        if test['validation']['Q3_VALID']:
            baseline['metrics']=test['metrics'];test['items']=base_items;best=test
            atomic_json('best_validated_q3_solution.json',{'items':base_items,'relay_sorties':baseline_relay,
                                                            'metrics':test['metrics'],'validation':test['validation']})
        else:baseline['status']='INFEASIBLE'
    conflict_rows=[r for r in baseline_static if r['minimum_relay_locations_lower_bound']>2]
    seed_options=[]
    if best is None:
        log('尝试定向同区并批、实体资源重排与两架中继转场种子')
        repaired_items,repaired_routes=targeted_rebatch_schedule(base_items,nodes,boxes,models,
            charge,terrain,uavs,batteries)
        _,repaired_blind=sample_direct(repaired_routes,terrain,comm,gw,60)
        repaired_demands=partition_demands(repaired_blind,repaired_routes)
        seed_ids=('RC0011','RC0128','RC0097')
        seed_locations=[next(c for c in candidates if c['id']==sid) for sid in seed_ids]
        repaired_active,repaired_links=coverage_matrix(seed_locations,repaired_demands,
            repaired_routes,terrain,comm,gw,relay)
        if len(repaired_links)==len(repaired_demands) and len(repaired_active)==3:
            seed_options=turnover_seed_options(repaired_active,repaired_demands,relay,relay_charge)
            relay_seed,seed_info=solve_relay_options(seed_options,repaired_demands,
                relay_uavs,relay_components,20,transport_return_s=max(r['return_s']
                for r in repaired_routes))
            log(f"转场种子 CP-SAT {seed_info['status']}，需求 {len(repaired_demands)}")
            if relay_seed is not None:
                check=validate_q3(repaired_items,relay_seed,nodes,boxes,models,uavs,batteries,
                    charge,terrain,relay,relay_uavs,relay_components,relay_charge,comm,gw,False)
                if check['validation']['Q3_VALID']:
                    best=check;best['items']=repaired_items
                    current_items=repaired_items;current_routes=repaired_routes
                    current_demands=repaired_demands;active=repaired_active
                    atomic_json('best_validated_q3_solution.json',
                        {'items':repaired_items,'relay_sorties':relay_seed,
                         'metrics':check['metrics'],'validation':check['validation']})
                    log('转场种子已通过独立区间通信 Validator 并原子存档')
                else:
                    log(f"转场种子未通过 Validator: {check['validation']['failures']}")
        else:
            log(f'转场候选覆盖不完整：{len(repaired_links)}/{len(repaired_demands)}')
    if baseline['status']=='INFEASIBLE':
        log(f'冻结运输加中继不可行；静态同时段冲突 {len(conflict_rows)} 处，开始定向错峰')
        if not conflict_rows:
            conflict_rows=[{'category':'RESOURCE_OR_ARRIVAL_CONFLICT','solver':baseline_info}]
        # 先保持零逾期；确有必要才允许普通物资正逾期，硬截止始终不可破。
        for zero_target in (True,False):
            if best:break
            moved=set()
            for round_no in range(1,7):
                score,proposals=candidate_transport_shifts(current_items,current_demands,candidates,
                    nodes,boxes,models,charge,terrain,comm,gw,zero_target)
                proposals=[p for p in proposals if (p['sortie_id'],p['shift_s']) not in moved]
                if not proposals:break
                log(f'修复轮 {round_no}，静态冲突分数 {score}，可用错峰提案 {len(proposals)}')
                chosen_proposal=None
                for proposal in proposals[:3]:
                    moved.add((proposal['sortie_id'],proposal['shift_s']))
                    if proposal['score']>0:
                        if chosen_proposal is None:chosen_proposal=proposal
                        continue
                    opts=build_relay_options(active,proposal['demands'],relay,relay_charge)
                    if not opts:continue
                    selected,info=solve_relay_options(opts,proposal['demands'],relay_uavs,
                        relay_components,35,transport_return_s=max(r['return_s'] for r in proposal['routes']))
                    log(f"错峰 {proposal['sortie_id']} +{proposal['shift_s']}s，静态分数 {proposal['score']}，CP-SAT {info['status']}")
                    if selected is not None:
                        test=validate_q3(proposal['items'],selected,nodes,boxes,models,uavs,batteries,
                            charge,terrain,relay,relay_uavs,relay_components,relay_charge,comm,gw,False)
                        if test['validation']['Q3_VALID']:
                            test['items']=proposal['items'];best=test;current_items=proposal['items']
                            current_routes=proposal['routes'];current_demands=proposal['demands']
                            atomic_json('best_validated_q3_solution.json',
                                {'items':current_items,'relay_sorties':selected,'metrics':test['metrics'],
                                 'validation':test['validation']})
                            log('获得首份通过区间通信认证的完整 Q3 解')
                            break
                    if chosen_proposal is None:chosen_proposal=proposal
                if best:break
                if chosen_proposal is None:break
                current_items=chosen_proposal['items'];current_routes=chosen_proposal['routes']
                current_demands=chosen_proposal['demands']
            if not best:
                current_items=base_items;current_routes=base_routes;current_demands=pieces
    write_csv('q3_conflicts.csv',conflict_rows)
    if best is None:
        write_json('q3_solver_status.json',{'baseline':baseline,'repair':'NO_CERTIFIED_FEASIBLE',
                                            'candidate_count':len(candidates),'blind_count':len(blind)})
        (OUT/'q3_solver_log.txt').write_text('\n'.join(LOG),encoding='utf-8')
        raise RuntimeError('已穷尽首轮定向错峰，尚未得到经连续通信认证的 Q3 解')
    log('[6/14] 在已验证解上逐层优化 F2/F3/F4')
    opts=build_relay_options(active,current_demands,relay,relay_charge)+seed_options
    locks={};best_relay=best['relay_sorties']
    tmax=max(r['return_s'] for r in best['routes'])
    for objective in ('makespan','energy','sorties'):
        chosen,info=solve_relay_options(opts,current_demands,relay_uavs,relay_components,
                  35,objective,locks=locks,transport_return_s=tmax)
        # 离散候选模型的 OPTIMAL 不自动等于连续通信正式可行或词典序最优。
        stage={'objective':objective,'status':'UNPROVEN',
               'solver_status':info['status'],'best_bound':info.get('best_bound'),
               'bound_scope':'current relay option pool only'}
        if chosen is not None:
            check=validate_q3(current_items,chosen,nodes,boxes,models,uavs,batteries,charge,
                   terrain,relay,relay_uavs,relay_components,relay_charge,comm,gw,False)
            stage['validator']=check['validation']['Q3_VALID']
            if check['validation']['Q3_VALID']:
                stage['status']='FEASIBLE'
                check['items']=current_items
                old=best['metrics'];new=check['metrics']
                if tuple(new[k] for k in ['ordinary_total_tardiness_s','joint_makespan_s',
                    'total_energy_kwh','total_sorties']) < tuple(old[k] for k in
                    ['ordinary_total_tardiness_s','joint_makespan_s','total_energy_kwh','total_sorties']):
                    best=check;best_relay=chosen
                    atomic_json('best_validated_q3_solution.json',
                                {'items':current_items,'relay_sorties':chosen,'metrics':new,
                                 'validation':check['validation']})
                if objective=='makespan':locks['makespan_ms']=math.ceil(new['joint_makespan_s']*1000+1e-6)
                if objective=='energy':locks['energy_micro']=math.ceil(new['relay_energy_kwh']*1e6+1e-6)
                if objective=='sorties':locks['sorties']=new['relay_sorties']
                stage['value']=new['joint_makespan_s' if objective=='makespan' else
                                   'relay_energy_kwh' if objective=='energy' else 'relay_sorties']
            else:
                stage['status']='REJECTED_BY_VALIDATOR'
        stages.append(stage)
    log('[7/14] 独立多尺度通信验证')
    formal=validate_q3(best['items'],best_relay,nodes,boxes,models,uavs,batteries,charge,
               terrain,relay,relay_uavs,relay_components,relay_charge,comm,gw,True)
    formal['items']=best['items']
    if not formal['validation']['Q3_VALID']:
        write_json('q3_validation.json',formal['validation'])
        raise RuntimeError(f"独立最终 Validator 未通过：{formal['validation']['failures']}")
    log('[8/14] 中继候选局部加密及粗细密度对照')
    local_density=local_refinement_compare(active,current_demands,formal['routes'],
        terrain,comm,gw,relay,nodes)
    log('[9/14] 结果、图表和官方模板导出')
    summary=export_final(formal,boxes,nodes,blind,coverage_rows,candidates,refinement,
                         conflict_rows,baseline,stages,freeze,relay,comm,gw,local_density)
    verify_freeze(freeze)
    (OUT/'q3_solver_log.txt').write_text('\n'.join(LOG),encoding='utf-8')
    print('==============================\nQ3 SOLVED\n==============================')
    for k in ['Q1_FREEZE_INTEGRITY','Q2_FREEZE_INTEGRITY','Q3_BASELINE_FROZEN_Q2_PLUS_RELAY',
              'GATE2_Q3_COMM_FEASIBLE','Q3_VALID','ordinary_total_tardiness_s','joint_makespan_s',
              'transport_energy_kwh','relay_energy_kwh','total_energy_kwh','transport_sorties',
              'relay_sorties','direct_blind_intervals','direct_blind_duration_s',
              'communication_outage_duration_upper_bound_s','uncertified_duration_s',
              'minimum_certified_link_margin_db']:
        print(f'{k} = {summary[k]}')
    print(f"official_template_export = {summary['excel']['official_template_export']}")
    print(f'results = {OUT}')


def verify_v1_freeze():
    """V1 的原件与快照逐一复核，后续修复绝不覆盖它们。"""
    manifest=jd(V1_FROZEN/'freeze_manifest.json')
    if manifest.get('Q3_V1_FREEZE')!='PASS':raise RuntimeError('Q3 V1 冻结未通过')
    for f in manifest['files']:
        rel=f['relative_path'];expected=f['sha256']
        if sha(V1/rel)!=expected or sha(V1_FROZEN/rel)!=expected:
            raise RuntimeError(f'Q3 V1 冻结哈希变化：{rel}')
    if sha(V1_FROZEN/'q3_source_snapshot.txt')!=manifest['source_sha256']:
        raise RuntimeError('Q3 V1 源码快照哈希变化')
    if not jd(V1/'q3_validation.json').get('Q3_VALID'):
        raise RuntimeError('Q3 V1 Validator 未通过')
    return manifest


def dependency_details(routes,intervals,relay_sorties):
    """运输同架次与同一次中继保障均为严格 must-link。"""
    services={r['sortie_id']:{sid for sid,_ in r['groups']} for r in routes}
    relay_targets=defaultdict(set)
    for x in intervals:
        if x['mode']=='RELAY':relay_targets[x['relay_sortie_id']].add(x['transport_sortie_id'])
    def components(excluded=None,include_relay=True):
        par={f'S{i:03d}':f'S{i:03d}' for i in range(1,16)}
        def root(x):
            while par[x]!=x:par[x]=par[par[x]];x=par[x]
            return x
        def join_all(vals):
            vals=sorted(vals)
            for v in vals[1:]:par[root(v)]=root(vals[0])
        for vals in services.values():join_all(vals)
        if include_relay:
            for rid,targets in relay_targets.items():
                if rid!=excluded:join_all(set().union(*(services[t] for t in targets)))
        result=defaultdict(list)
        for s in par:result[root(s)].append(s)
        return sorted((sorted(v) for v in result.values()),key=lambda v:v[0])
    whole=components();transport=components(include_relay=False)
    bridges=[]
    for r in relay_sorties:
        rid=r['sortie_id'];targets=sorted(relay_targets[rid]);removed=components(rid)
        bridges.append({'relay_sortie_id':rid,'transport_sorties':','.join(targets),
                        'covered_services':','.join(sorted(set().union(*(services[t] for t in targets)))) if targets else '',
                        'component_count_after_removal':len(removed),'bridge_gain':len(removed)-len(whole)})
    return {'strict_components':whole,'transport_components':transport,
            'strict_component_count':len(whole),'transport_component_count':len(transport),
            'relay_bridges':bridges}


def repaired_relay(original,sortie_id,start,end,component,flight,relay,charge_s):
    r={k:v for k,v in original.items() if k not in ('covered_demands','id','candidate_id')}
    prep=float(relay['工位固定准备时间（s）']);link=float(relay['建链时间（s）'])
    ready=start+prep+flight['out_s']+link
    energy=relay_energy(relay,flight,end-ready)
    soc=1-energy/float(relay['能源组件可用能量（kWh）'])
    ret=end+flight['back_s']
    r.update({'sortie_id':sortie_id,'start_s':start,'arrival_s':ready-link,
              'link_ready_s':ready,'service_start_s':ready,'service_end_s':end,
              'return_s':ret,'uav_release_s':ret+float(relay['架次周转时间（s）']),
              'component_full_s':ret+charging_time(soc,charge_s),'energy_kwh':energy,
              'return_soc':soc,'component_id':component})
    return r


def apply_validated_robustness_once(base, nodes, boxes, models, uavs, batteries,
                                    charge, terrain, relay, relay_uavs,
                                    relay_components, relay_charge, comm, gw):
    """复现唯一一轮已验证的局部格点调整；不改变运输路线和物理公式。"""
    old={r['sortie_id']:r for r in base['relay_sorties']}
    choices=(('Q3-R001','Q3-R003',50,1,-1),
             ('Q3-R002','Q3-R004',100,-1,-1))
    replacements={}
    for rid,next_id,radius,dx,dy in choices:
        original=old[rid]
        x,y=TR.transform(original['lon'],original['lat'])
        scale=radius/math.hypot(dx,dy)
        lon,lat=INV_TR.transform(x+scale*dx,y+scale*dy)
        flight=relay_flight(terrain,nodes,relay,lon,lat,original['agl_m'])
        if flight is None:raise RuntimeError(f'{rid}: 稳健化位置飞行几何失效')
        next_start=old[next_id]['start_s']
        end=max(original['service_end_s'],next_start-
                float(relay['架次周转时间（s）'])-flight['back_s']-0.01)
        merged={**original,**{k:flight[k] for k in
                ('lon','lat','ground_m','agl_m','alt_m','out_s','back_s','flight_energy_kwh')}}
        replacements[rid]=repaired_relay(merged,rid,original['start_s'],end,
                                         original['component_id'],flight,relay,relay_charge)
    chosen={**old,**replacements}
    # R004 与 R003 同时可用时先用 R004，避免把本可分开的任务连成同一依赖量。
    rr=sorted(chosen.values(),key=lambda r:0 if r['sortie_id']=='Q3-R004' else 1)
    result=validate_q3(base['items'],rr,nodes,boxes,models,uavs,batteries,charge,
                       terrain,relay,relay_uavs,relay_components,relay_charge,
                       comm,gw,True,robust_source_preference=True)
    result['items']=base['items']
    graph=dependency_details(result['routes'],result['intervals'],result['relay_sorties'])
    margin=result['validation'].get('minimum_certified_link_margin_db',float('-inf'))
    if (not result['validation']['Q3_VALID'] or
        result['metrics']['ordinary_total_tardiness_s']>1e-8 or
        graph['strict_component_count']<3 or margin<0.13404147515810508-1e-9):
        raise RuntimeError('唯一一轮稳健化重现未通过 Q3/依赖/0.1dB 增益门禁')
    log(f'稳健化重现：全程最小认证余量 {margin:.9f} dB；严格分量 {graph["strict_component_count"]}')
    return result,graph


def main_repair():
    global OUT
    print('==============================\nQ3 兼容性修复开始\n==============================',flush=True)
    REPAIR.mkdir(parents=True,exist_ok=True);OUT=REPAIR
    verify_v1_freeze()
    freeze=upstream_freeze()
    nodes,boxes,models,uavs,batteries,charge,relay,relay_uavs,relay_components,relay_charge,raw=load_inputs()
    terrain=Terrain();comm=comm_parameters(raw);gw=gateway(nodes,comm)
    v1=jd(V1/'q3_solution.json');base_items=v1['transport_items'];base_relays=v1['relay_sorties']
    base_routes,_,_=validate_transport(base_items,nodes,boxes,models,uavs,batteries,charge,terrain)
    dep=dependency_details(base_routes,v1['communication_intervals'],base_relays)
    write_json('q3_v1_dependency_graph.json',dep)
    write_csv('relay_dependency_bridges.csv',dep['relay_bridges'])
    (REPAIR/'relay_dependency_bridges.md').write_text('# Q3 V1 严格中继依赖\n\n'+
        f"运输单独 {dep['transport_component_count']} 个分量；加入中继后 {dep['strict_component_count']} 个。\n\n"+
        '\n'.join(f"- {r['relay_sortie_id']}: {r['covered_services']}；移除后 {r['component_count_after_removal']} 个分量，桥接增益 {r['bridge_gain']}。" for r in dep['relay_bridges'])+'\n',encoding='utf-8')
    old=next(r for r in base_relays if r['sortie_id']=='Q3-R004')
    target='Q3-T023'
    rows=[r for r in v1['communication_intervals'] if r['mode']=='RELAY' and r['relay_sortie_id']=='Q3-R004']
    last_other=max(r['end_s'] for r in rows if r['transport_sortie_id']!=target)
    first_target=min(r['start_s'] for r in rows if r['transport_sortie_id']==target)
    last_target=max(r['end_s'] for r in rows if r['transport_sortie_id']==target)
    flight=relay_flight(terrain,nodes,relay,old['lon'],old['lat'],old['agl_m'])
    early_end=last_other+5.0
    early=repaired_relay(old,'Q3-R004',old['start_s'],early_end,old['component_id'],flight,relay,relay_charge)
    prep=float(relay['工位固定准备时间（s）']);link=float(relay['建链时间（s）'])
    late_start=early['uav_release_s']+0.001
    min_shift=late_start+prep+flight['out_s']+link-first_target+1.0
    log(f'R004 非 S005 最后保障 {last_other:.3f}s；S005 首次需求 {first_target:.3f}s；理论错峰下界 {min_shift:.3f}s')
    starts=[770]+[x for x in range(max(0,10*math.ceil(min_shift/10)),1201,10) if x!=770]
    tests=[];best=None
    def trial(shift):
        items=json.loads(json.dumps(base_items,ensure_ascii=False))
        next(i for i in items if i['sortie_id']==target)['start_s']+=shift
        late=repaired_relay(old,'Q3-R005',late_start,last_target+shift+5.0,'R_COMP_01',flight,relay,relay_charge)
        relays=[r for r in base_relays if r['sortie_id']!='Q3-R004']+[early,late]
        result=validate_q3(items,relays,nodes,boxes,models,uavs,batteries,charge,terrain,
                           relay,relay_uavs,relay_components,relay_charge,comm,gw,False)
        result['items']=items
        d=dependency_details(result['routes'],result['intervals'],result['relay_sorties'])
        result['dependency']=d
        valid=result['validation']['Q3_VALID'] and result['metrics']['ordinary_total_tardiness_s']<=1e-8 and d['strict_component_count']>=3
        tests.append({'shift_s':shift,'Q3_VALID':result['validation']['Q3_VALID'],
                      'tardiness_s':result['metrics']['ordinary_total_tardiness_s'],
                      'component_count':d['strict_component_count'],
                      'outage_upper_s':result['validation'].get('communication_outage_duration_upper_bound_s',0),
                      'uncertified_s':result['validation'].get('uncertified_duration_s',0),
                      'failures':result['validation']['failures'],'qualified':valid})
        return result if valid else None
    for shift in starts:
        cand=trial(shift)
        if cand is not None:
            best=cand;log(f'10 秒网格找到合格错峰 {shift}s');break
    if best is None:
        write_csv('repair_search.csv',tests)
        raise RuntimeError('拆分 R004 与错峰 T023 未找到合格解；须进入后续定向修复分支')
    coarse=best['items'][next(i for i,x in enumerate(best['items']) if x['sortie_id']==target)]['start_s']-next(x for x in base_items if x['sortie_id']==target)['start_s']
    for shift in range(max(math.ceil(min_shift),int(coarse)-9),int(coarse)):
        cand=trial(shift)
        if cand is not None and tuple(cand['metrics'][k] for k in ('joint_makespan_s','total_energy_kwh','total_sorties'))<tuple(best['metrics'][k] for k in ('joint_makespan_s','total_energy_kwh','total_sorties')):best=cand
    write_csv('repair_search.csv',tests)
    log('执行完整连续区间认证和 10/5/2.5 米采样')
    formal=validate_q3(best['items'],best['relay_sorties'],nodes,boxes,models,uavs,batteries,charge,terrain,
                       relay,relay_uavs,relay_components,relay_charge,comm,gw,True)
    formal['items']=best['items']
    final_dep=dependency_details(formal['routes'],formal['intervals'],formal['relay_sorties'])
    if not formal['validation']['Q3_VALID'] or formal['metrics']['ordinary_total_tardiness_s']>1e-8 or final_dep['strict_component_count']<3:
        write_json('full_validation_failure.json',{'validation':formal['validation'],'dependency':final_dep})
        raise RuntimeError('Q3 完整认证或严格 K3 门禁未通过')
    atomic_json('best_validated_repair.json',{'transport_items':formal['items'],'relay_sorties':formal['relay_sorties'],
                 'metrics':formal['metrics'],'validation':formal['validation'],'dependency':final_dep})
    formal,final_dep=apply_validated_robustness_once(formal,nodes,boxes,models,uavs,
        batteries,charge,terrain,relay,relay_uavs,relay_components,relay_charge,comm,gw)
    FINAL.mkdir(parents=True,exist_ok=True);(FINAL/'figures').mkdir(exist_ok=True);OUT=FINAL
    coverage,blind=sample_direct(formal['routes'],terrain,comm,gw,60)
    old_summary=jd(V1/'q3_summary.json')
    cache=jd(V1/'q3_candidate_cache.json')
    refinement=[{'round':0,'candidate_count':old_summary['relay_candidates_initial']}]
    baseline={'status':old_summary.get('Q3_BASELINE_FROZEN_Q2_PLUS_RELAY','INFEASIBLE')}
    export_final(formal,boxes,nodes,blind,coverage,cache['candidates'],refinement,[],baseline,
                 [{'objective':'Q3 compatibility','status':'FEASIBLE'}],freeze,relay,comm,gw,
                 old_summary['local_candidate_density'])
    detailed={'transport_items':formal['items'],'transport_routes':formal['routes'],
              'relay_sorties':formal['relay_sorties'],'communication_intervals':formal['intervals'],
              'metrics':formal['metrics'],'dependency':final_dep}
    write_json('q3_final_solution.json',detailed)
    write_json('q3_dependency_graph.json',final_dep)
    write_csv('q3_dependency_bridges.csv',final_dep['relay_bridges'])
    (FINAL/'q3_dependency_graph.md').write_text('# Q3 Final 严格依赖图\n\n'+
       '\n'.join(f"- 分量 {i}: {', '.join(c)}" for i,c in enumerate(final_dep['strict_components'],1))+'\n',encoding='utf-8')
    v1m=jd(V1/'q3_summary.json')
    compare=[{'metric':k,'V1':v1m.get(k),'Final':formal['metrics'].get(k)} for k in formal['metrics']]
    compare.append({'metric':'strict_component_count','V1':dep['strict_component_count'],'Final':final_dep['strict_component_count']})
    write_csv('q3_v1_vs_final.csv',compare)
    src=FINAL/'结果提交模板_Q1Q2Q3已填写.xlsx';dst=FINAL/'结果提交模板_Q1Q2Q3_最终版.xlsx'
    shutil.copy2(src,dst)
    wb=load_workbook(dst);prev=load_workbook(V1/'结果提交模板_Q1Q2Q3已填写.xlsx')
    unchanged=all(sheet_fingerprint(wb[s])==sheet_fingerprint(prev[s]) for s in ('Q1_单点组批','Q2_运输架次','Q2_逐箱交付'))
    wb.close();prev.close()
    if not unchanged:raise RuntimeError('Q3 Final 模板 Q1/Q2 Sheet 发生变化')
    final_summary={**formal['metrics'],'Q3_VALID':True,'GATE2_Q3_COMM_FEASIBLE':'PASS',
                   'Q4_K3_READY':True,'strict_component_count':final_dep['strict_component_count'],
                   'minimum_certified_link_margin_db':formal['validation']['minimum_certified_link_margin_db'],
                   'Q1_Q2_sheets_unchanged':True,'sampling_convergence':formal['sampling_convergence']}
    write_json('q3_final_summary.json',final_summary)
    (FINAL/'q3_final_summary.md').write_text('# Q3 Final\n\n'+
        f"Q3_VALID = TRUE；普通物资逾期 {formal['metrics']['ordinary_total_tardiness_s']:.6f}s；严格依赖分量 {final_dep['strict_component_count']}。\n\n"+
        f"V1→Final 联合完成时间 {v1m['joint_makespan_s']:.3f}→{formal['metrics']['joint_makespan_s']:.3f}s；中继架次 {v1m['relay_sorties']}→{formal['metrics']['relay_sorties']}。\n",encoding='utf-8')
    verify_freeze(freeze);verify_v1_freeze()
    frozen_files=['q3_final_solution.json','q3_final_summary.json','q3_validation.json',
                  'q3_dependency_graph.json','结果提交模板_Q1Q2Q3_最终版.xlsx']
    manifest={'Q3_FINAL_FREEZE':'PASS','Q3_VALID':True,'Q4_K3_READY':True,
              'source_sha256':sha(ROOT/'src/q3.python'),
              'files':{f:sha(FINAL/f) for f in frozen_files},
              'upstream':freeze['files'],'v1_source_sha256':sha(V1_FROZEN/'q3_source_snapshot.txt')}
    write_json('q3_final_freeze_manifest.json',manifest)
    (FINAL/'q3_solver_log.txt').write_text('\n'.join(LOG),encoding='utf-8')
    print('==============================\nQ3 FINAL FREEZE = PASS\n==============================')
    print(f"Q3_VALID = TRUE; ordinary_tardiness_s = {formal['metrics']['ordinary_total_tardiness_s']:.6f}; strict_components = {final_dep['strict_component_count']}")
    print(f'results = {FINAL}')


if __name__=='__main__':
    main_repair()
